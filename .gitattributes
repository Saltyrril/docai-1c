# Все текстовые файлы храним с переводом строки LF (shell-хуки иначе ломаются).
* text=auto eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Двоичные файлы
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.epf binary

# Официальная XSD ФНС хранится байт в байт (windows-1251, CRLF), хуки её не правят
src/docai/edo/xsd/*.xsd -text
