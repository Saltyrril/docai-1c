// Обработка «Загрузка первичных документов (ИИ)» (шаг P16): общий серверный код форм.
//
// Связь с сервисом docai — HTTP, способ А из P15 (D54): POST /v1/extract, GET /v1/jobs/{id},
// GET /v1/jobs/{id}/preview/{страница}, POST /v1/jobs/{id}/feedback. Контракт — docs/API.md.
// Формы вызывают модуль на сервере через РеквизитФормыВЗначение("Объект"). В файловой базе
// сервер 1С — тот же компьютер, поэтому адрес сервиса 127.0.0.1.
//
// Модуль рассчитан на конфигурацию с режимом совместимости 8.3.9 и новее (учебная
// Бухгалтерия 3.0.111 — 8.3.16): используются СоединитьДвоичныеДанные, ПрочитатьJSON, СтрШаблон.

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Отправляет файл на распознавание: POST /v1/extract (multipart/form-data, поле file).
//
// Параметры:
//   Адрес - Строка - адрес сервиса.
//   Порт - Число - порт сервиса.
//   ДанныеФайла - ДвоичныеДанные - содержимое файла.
//   ИмяФайла - Строка - имя файла без пути, сервис хранит его как метку.
//
// Возвращаемое значение:
//   Структура - Успех (Булево), ИдЗадания (Строка), ВОчереди (Число), Ошибка (Строка).
//
Функция ОтправитьФайл(Адрес, Порт, ДанныеФайла, ИмяФайла) Экспорт

	Результат = Новый Структура("Успех, ИдЗадания, ВОчереди, Ошибка", Ложь, "", 0, "");

	Граница = "docai" + СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "");
	ПереводСтроки = Символы.ВК + Символы.ПС;
	Начало = "--" + Граница + ПереводСтроки
		+ "Content-Disposition: form-data; name=""file""; filename=""" + ИмяДляЗаголовка(ИмяФайла) + """"
		+ ПереводСтроки
		+ "Content-Type: application/octet-stream" + ПереводСтроки + ПереводСтроки;
	Конец = ПереводСтроки + "--" + Граница + "--" + ПереводСтроки;

	Части = Новый Массив;
	Части.Добавить(ПолучитьДвоичныеДанныеИзСтроки(Начало, КодировкаТекста.UTF8, Ложь));
	Части.Добавить(ДанныеФайла);
	Части.Добавить(ПолучитьДвоичныеДанныеИзСтроки(Конец, КодировкаТекста.UTF8, Ложь));

	// Загрузка до 20 МБ по локальной сети занимает доли секунды; запас — на медленный диск.
	Ответ = ВыполнитьЗапрос(Адрес, Порт, "POST", "/v1/extract", СоединитьДвоичныеДанные(Части),
		"multipart/form-data; boundary=" + Граница, 120);
	Если Не ПустаяСтрока(Ответ.Ошибка) Тогда
		Результат.Ошибка = Ответ.Ошибка;
		Возврат Результат;
	КонецЕсли;
	Если Ответ.Код <> 202 Тогда
		Результат.Ошибка = ТекстОшибкиСервиса(Ответ);
		Возврат Результат;
	КонецЕсли;

	Принято = РазобратьJSON(Ответ.Текст);
	Результат.Успех = Истина;
	Результат.ИдЗадания = Принято.id;
	Результат.ВОчереди = ?(Принято.queue_ahead = Неопределено, 0, Принято.queue_ahead);
	Возврат Результат;

КонецФункции

// Состояние задания и результат распознавания: GET /v1/jobs/{id}.
//
// Возвращаемое значение:
//   Структура - Успех (Булево), Данные (Структура - JSON задания, ключи как в docs/API.md),
//               Код (Число - код ответа HTTP, 0 — нет связи), Ошибка (Строка).
//
Функция ПолучитьЗадание(Адрес, Порт, ИдЗадания) Экспорт

	Результат = Новый Структура("Успех, Данные, Код, Ошибка", Ложь, Неопределено, 0, "");
	Ответ = ВыполнитьЗапрос(Адрес, Порт, "GET", "/v1/jobs/" + ИдЗадания);
	Результат.Код = Ответ.Код;
	Если Не ПустаяСтрока(Ответ.Ошибка) Тогда
		Результат.Ошибка = Ответ.Ошибка;
	ИначеЕсли Ответ.Код <> 200 Тогда
		Результат.Ошибка = ТекстОшибкиСервиса(Ответ);
	Иначе
		Результат.Данные = РазобратьJSON(Ответ.Текст);
		Результат.Успех = Истина;
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Страница документа в PNG: GET /v1/jobs/{id}/preview/{номер}.
//
// Возвращаемое значение:
//   Структура - Успех (Булево), Данные (ДвоичныеДанные), Ошибка (Строка).
//
Функция ПолучитьСтраницу(Адрес, Порт, ИдЗадания, НомерСтраницы) Экспорт

	Результат = Новый Структура("Успех, Данные, Ошибка", Ложь, Неопределено, "");
	Ответ = ВыполнитьЗапрос(Адрес, Порт, "GET",
		"/v1/jobs/" + ИдЗадания + "/preview/" + Формат(НомерСтраницы, "ЧГ=0"), , , 30, Истина);
	Если Не ПустаяСтрока(Ответ.Ошибка) Тогда
		Результат.Ошибка = Ответ.Ошибка;
	ИначеЕсли Ответ.Код <> 200 Тогда
		Результат.Ошибка = ТекстОшибкиСервиса(Ответ);
	Иначе
		Результат.Данные = Ответ.Данные;
		Результат.Успех = Истина;
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Отправляет значения, которые проверил человек: POST /v1/jobs/{id}/feedback.
//
// Параметры:
//   Значения - Соответствие - имя поля (seller.inn, lines[0].price) -> Строка или Неопределено (null).
//   Автор - Строка - кто проверял.
//   Комментарий - Строка - необязательный комментарий.
//
// Возвращаемое значение:
//   Структура - Успех (Булево), Всего (Число), Изменено (Число), Ошибка (Строка).
//
Функция ОтправитьПравки(Адрес, Порт, ИдЗадания, Значения, Автор, Комментарий = "") Экспорт

	Результат = Новый Структура("Успех, Всего, Изменено, Ошибка", Ложь, 0, 0, "");

	Тело = Новый Соответствие;
	Тело.Вставить("fields", Значения);
	Тело.Вставить("author", Автор);
	Если Не ПустаяСтрока(Комментарий) Тогда
		Тело.Вставить("comment", Комментарий);
	КонецЕсли;

	Ответ = ВыполнитьЗапрос(Адрес, Порт, "POST", "/v1/jobs/" + ИдЗадания + "/feedback",
		ЗаписатьВJSON(Тело), "application/json; charset=utf-8");
	Если Не ПустаяСтрока(Ответ.Ошибка) Тогда
		Результат.Ошибка = Ответ.Ошибка;
	ИначеЕсли Ответ.Код <> 200 Тогда
		Результат.Ошибка = ТекстОшибкиСервиса(Ответ);
	Иначе
		Итог = РазобратьJSON(Ответ.Текст);
		Результат.Успех = Истина;
		Результат.Всего = Итог.total;
		Результат.Изменено = Итог.changed;
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Краткое состояние сервиса для шапки формы: GET /v1/health.
//
// Возвращаемое значение:
//   Строка - «готов: модель ..., в очереди 0» или причина, почему сервис недоступен.
//
Функция ОписаниеСостоянияСервиса(Адрес, Порт) Экспорт

	Ответ = ВыполнитьЗапрос(Адрес, Порт, "GET", "/v1/health", , , 10);
	Если Не ПустаяСтрока(Ответ.Ошибка) Тогда
		Возврат Ответ.Ошибка;
	ИначеЕсли Ответ.Код <> 200 Тогда
		Возврат ТекстОшибкиСервиса(Ответ);
	КонецЕсли;

	Сервис = РазобратьJSON(Ответ.Текст);
	Ollama = Сервис.ollama;
	Если Сервис.status = "ok" Тогда
		Текст = СтрШаблон(НСтр("ru = 'готов: модель %1, в очереди %2, выполняется %3'"),
			Ollama.model, Сервис.queued, Сервис.running);
	Иначе
		Текст = СтрШаблон(НСтр("ru = 'работает не полностью: %1. PDF без текста и сканы не распознаются, XML из ЭДО — да'"),
			?(Ollama.error = Неопределено, НСтр("ru = 'модель недоступна'"), Ollama.error));
	КонецЕсли;
	Возврат СтрШаблон(НСтр("ru = 'http://%1:%2 — %3'"), Адрес, Формат(Порт, "ЧГ=0"), Текст);

КонецФункции

// Значения полей задания по именам.
//
// Параметры:
//   Данные - Структура - JSON задания.
//
// Возвращаемое значение:
//   Соответствие - имя поля -> значение строкой или Неопределено.
//
Функция ЗначенияПолей(Данные) Экспорт

	Значения = Новый Соответствие;
	Если ТипЗнч(Данные.fields) = Тип("Массив") Тогда
		Для Каждого Поле Из Данные.fields Цикл
			Значения.Вставить(Поле.name, Поле.value);
		КонецЦикла;
	КонецЕсли;
	Возврат Значения;

КонецФункции

// Название реквизита для человека: seller.inn -> «Продавец: ИНН».
//
// Параметры:
//   ИмяПоля - Строка - путь поля, как в ответе сервиса.
//
// Возвращаемое значение:
//   Строка - название; для неизвестного поля — сам путь.
//
Функция ПредставлениеПоля(ИмяПоля) Экспорт

	Части = СтрРазделить(ИмяПоля, ".");
	Если Части.Количество() = 2 Тогда
		Владелец = ПредставлениеЧасти(Части[0]);
		Реквизит = ПредставлениеЧасти(Части[1]);
		Если Владелец = Неопределено Или Реквизит = Неопределено Тогда
			Возврат ИмяПоля;
		КонецЕсли;
		Возврат Владелец + ": " + Реквизит;
	КонецЕсли;

	Название = ПредставлениеЧасти(ИмяПоля);
	Возврат ?(Название = Неопределено, ИмяПоля, Название);

КонецФункции

// Вид документа по коду сервиса: bill -> «Счёт на оплату».
Функция ПредставлениеВидаДокумента(КодВида, СтатусУПД = Неопределено) Экспорт

	Виды = Новый Соответствие;
	Виды.Вставить("upd", НСтр("ru = 'УПД'"));
	Виды.Вставить("bill", НСтр("ru = 'Счёт на оплату'"));
	Виды.Вставить("act", НСтр("ru = 'Акт'"));
	Виды.Вставить("torg12", НСтр("ru = 'ТОРГ-12'"));
	Виды.Вставить("vat_invoice", НСтр("ru = 'Счёт-фактура'"));

	Если КодВида = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Название = Виды.Получить(КодВида);
	Если Название = Неопределено Тогда
		Название = КодВида;
	КонецЕсли;
	Если КодВида = "upd" И ЗначениеЗаполнено(СтатусУПД) Тогда
		Название = СтрШаблон(НСтр("ru = '%1 (статус %2)'"), Название, СтатусУПД);
	КонецЕсли;
	Возврат Название;

КонецФункции

// Состояние задания словами для списка загрузок.
//
// Параметры:
//   Данные - Структура - JSON задания.
//
// Возвращаемое значение:
//   Строка - «В очереди (впереди 2)», «Распознаётся...», «Готово: нужна проверка».
//
Функция ПредставлениеСостояния(Данные) Экспорт

	Если Данные.status = "queued" Тогда
		Возврат ПредставлениеОчереди(Данные.queue_ahead);
	ИначеЕсли Данные.status = "running" Тогда
		Возврат НСтр("ru = 'Распознаётся...'");
	ИначеЕсли Данные.status = "done" Тогда
		Если Данные.document_status_ru = Неопределено Тогда
			Возврат НСтр("ru = 'Готово'");
		КонецЕсли;
		Возврат СтрШаблон(НСтр("ru = 'Готово: %1'"), Данные.document_status_ru);
	ИначеЕсли Данные.status = "failed" Тогда
		Возврат НСтр("ru = 'Ошибка распознавания'");
	КонецЕсли;
	Возврат Данные.status;

КонецФункции

// «В очереди (впереди N)» по числу заданий впереди.
Функция ПредставлениеОчереди(Впереди) Экспорт

	Если Не ЗначениеЗаполнено(Впереди) Тогда
		Возврат НСтр("ru = 'В очереди'");
	КонецЕсли;
	Возврат СтрШаблон(НСтр("ru = 'В очереди (впереди %1)'"), Формат(Впереди, "ЧГ=0"));

КонецФункции

// Разбирает JSON в Структуру (объекты) и Массив. Ключи ответа сервиса — латиница,
// они годятся как ключи Структуры; null становится Неопределено.
Функция РазобратьJSON(Текст, ВСоответствие = Ложь) Экспорт

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Текст);
	Значение = ПрочитатьJSON(Чтение, ВСоответствие);
	Чтение.Закрыть();
	Возврат Значение;

КонецФункции

// Записывает Структуру, Соответствие или Массив в строку JSON.
Функция ЗаписатьВJSON(Значение) Экспорт

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	ЗаписатьJSON(Запись, Значение);
	Возврат Запись.Закрыть();

КонецФункции

#КонецОбласти

#Область СопоставлениеСоСправочниками

// Сопоставляет распознанный документ со справочниками 1С (P16, часть 2): организация — по ИНН
// покупателя, контрагент — по ИНН и КПП продавца, договор — по номеру и дате основания,
// номенклатура — по наименованию (точно или похожие), единица измерения — по коду ОКЕИ.
// Справочники читаются одним пакетным запросом; сравнение и ранжирование — в памяти.
//
// Параметры:
//   Реквизиты - Структура - ИННПокупателя, КПППокупателя, ИННПродавца, КПППродавца,
//               НомерДоговора, ДатаДоговора (Дата), ВидДокумента (код сервиса: upd, bill, act...).
//   Строки - Массив из Структура - Наименование, ЕдИзм, КодЕдИзм.
//
// Возвращаемое значение:
//   Структура - Организация, Контрагент, Договор (ссылки), их Уровень... (0 — найдено,
//   1 — проверьте, 2 — не найдено) и Состояние... (текст для формы); Строки — Массив из Структура
//   (Номенклатура, ЕдиницаИзмерения, ЭтоУслуга, Уровень, Состояние, Похожие — Массив из Структура
//   Ссылка, Наименование, Сходство).
//
Функция СопоставитьСоСправочниками(Реквизиты, Строки) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Организация", Справочники.Организации.ПустаяСсылка());
	Результат.Вставить("УровеньОрганизации", 2);
	Результат.Вставить("СостояниеОрганизации", "");
	Результат.Вставить("Контрагент", Справочники.Контрагенты.ПустаяСсылка());
	Результат.Вставить("УровеньКонтрагента", 2);
	Результат.Вставить("СостояниеКонтрагента", "");
	Результат.Вставить("Договор", Справочники.ДоговорыКонтрагентов.ПустаяСсылка());
	Результат.Вставить("УровеньДоговора", 2);
	Результат.Вставить("СостояниеДоговора", "");
	Результат.Вставить("Строки", Новый Массив);

	Основы = ОсновыСтрок(Строки);
	Запрос = Новый Запрос(ТекстЗапросаСопоставления(Основы.Количество()));
	Запрос.УстановитьПараметр("ИННПродавца", СокрЛП(Реквизиты.ИННПродавца));
	Запрос.УстановитьПараметр("КодыЕдиниц", ЗначенияСтрок(Строки, "КодЕдИзм"));
	Запрос.УстановитьПараметр("НаименованияЕдиниц", ЗначенияСтрок(Строки, "ЕдИзм"));
	Запрос.УстановитьПараметр("Наименования", ЗначенияСтрок(Строки, "Наименование"));
	Для Индекс = 0 По Основы.ВГраница() Цикл
		Запрос.УстановитьПараметр("Основа" + Формат(Индекс, "ЧН=0; ЧГ=0"),
			"%" + ЭкранироватьДляПодобно(Основы[Индекс]) + "%");
	КонецЦикла;
	Пакет = Запрос.ВыполнитьПакет();

	ВыбратьОрганизацию(Результат, Пакет[0].Выгрузить(), Реквизиты);
	ВыбратьКонтрагента(Результат, Пакет[1].Выгрузить(), Реквизиты);
	Если ЗначениеЗаполнено(Результат.Контрагент) Тогда
		Договор = ПодобратьДоговор(Результат.Контрагент, Результат.Организация,
			Реквизиты.НомерДоговора, Реквизиты.ДатаДоговора);
		Результат.Договор = Договор.Договор;
		Результат.УровеньДоговора = Договор.Уровень;
		Результат.СостояниеДоговора = Договор.Состояние;
	Иначе
		Результат.СостояниеДоговора = НСтр("ru = 'сначала выберите или создайте контрагента'");
	КонецЕсли;

	Единицы = Пакет[2].Выгрузить();
	Номенклатура = Пакет[3].Выгрузить();
	Номенклатура.Колонки.Добавить("Основы");
	Номенклатура.Колонки.Добавить("Нормализованное");
	Для Каждого Элемент Из Номенклатура Цикл
		Элемент.Нормализованное = НормализованноеНаименование(Элемент.Наименование);
		Элемент.Основы = ОсновыНаименования(Элемент.Наименование);
	КонецЦикла;

	ЭтоАкт = (Реквизиты.ВидДокумента = "act");
	Для Каждого СтрокаДокумента Из Строки Цикл
		Результат.Строки.Добавить(СопоставитьСтроку(СтрокаДокумента, Номенклатура, Единицы, ЭтоАкт));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Договор с поставщиком у контрагента: по номеру и дате основания документа, а если номера
// нет — единственный договор с поставщиком. Вызывается и при смене контрагента в форме.
//
// Параметры:
//   Контрагент - СправочникСсылка.Контрагенты
//   Организация - СправочникСсылка.Организации - пустая: договоры всех организаций.
//   НомерДоговора - Строка - номер из основания документа (может быть пустым).
//   ДатаДоговора - Дата - дата из основания документа (может быть пустой).
//
// Возвращаемое значение:
//   Структура - Договор, Уровень (0, 1, 2), Состояние (Строка).
//
Функция ПодобратьДоговор(Контрагент, Организация, НомерДоговора, ДатаДоговора) Экспорт

	Результат = Новый Структура("Договор, Уровень, Состояние",
		Справочники.ДоговорыКонтрагентов.ПустаяСсылка(), 2, "");
	Если Не ЗначениеЗаполнено(Контрагент) Тогда
		Результат.Состояние = НСтр("ru = 'сначала выберите или создайте контрагента'");
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Договоры.Ссылка КАК Ссылка,
	|	Договоры.Номер КАК Номер,
	|	Договоры.Дата КАК Дата
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК Договоры
	|ГДЕ
	|	Договоры.Владелец = &Контрагент
	|	И НЕ Договоры.ЭтоГруппа
	|	И НЕ Договоры.ПометкаУдаления
	|	И Договоры.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.СПоставщиком)
	|	И (Договоры.Организация = &Организация
	|		ИЛИ &Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка))";
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("Организация", Организация);
	Договоры = Запрос.Выполнить().Выгрузить();

	Номер = НормализованныйНомер(НомерДоговора);
	Если Не ПустаяСтрока(Номер) Тогда
		Для Каждого Договор Из Договоры Цикл
			Если НормализованныйНомер(Договор.Номер) <> Номер Тогда
				Продолжить;
			КонецЕсли;
			Результат.Договор = Договор.Ссылка;
			Если Не ЗначениеЗаполнено(ДатаДоговора) Или НачалоДня(Договор.Дата) = НачалоДня(ДатаДоговора) Тогда
				Результат.Уровень = 0;
				Результат.Состояние = НСтр("ru = 'найден по номеру и дате'");
			Иначе
				Результат.Уровень = 1;
				Результат.Состояние = СтрШаблон(НСтр("ru = 'номер совпал, дата в 1С другая: %1 — проверьте'"),
					Формат(Договор.Дата, "ДЛФ=D"));
			КонецЕсли;
			Возврат Результат;
		КонецЦикла;
		Результат.Состояние = СтрШаблон(НСтр("ru = 'договора № %1 нет — создайте'"), СокрЛП(НомерДоговора));
		Возврат Результат;
	КонецЕсли;

	Если Договоры.Количество() = 1 Тогда
		Результат.Договор = Договоры[0].Ссылка;
		Результат.Уровень = 1;
		Результат.Состояние = НСтр("ru = 'в документе нет номера договора; взят единственный договор с поставщиком — проверьте'");
	ИначеЕсли Договоры.Количество() = 0 Тогда
		Результат.Состояние = НСтр("ru = 'договоров с поставщиком нет — создайте'");
	Иначе
		Результат.Состояние = СтрШаблон(НСтр("ru = 'договоров с поставщиком: %1, в документе номера нет — выберите'"),
			Договоры.Количество());
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Значения заполнения для новых элементов справочников: открываются стандартные формы элементов,
// человек проверяет и записывает. Ключи — реквизиты справочников (по выгрузке конфигурации, D58).
//
// Параметры:
//   Вид - Строка - "Контрагент", "Договор" или "Номенклатура".
//   Данные - Структура - распознанные значения (см. формы обработки).
//
// Возвращаемое значение:
//   Структура - значения заполнения для параметра формы ЗначенияЗаполнения.
//
Функция ЗначенияЗаполненияНовогоЭлемента(Вид, Данные) Экспорт

	Значения = Новый Структура;
	Если Вид = "Контрагент" Тогда
		Наименование = СокрЛП(Данные.Наименование);
		Значения.Вставить("Наименование", Наименование);
		Значения.Вставить("НаименованиеПолное", Наименование);
		Значения.Вставить("ИНН", СокрЛП(Данные.ИНН));
		Значения.Вставить("КПП", СокрЛП(Данные.КПП));
		Значения.Вставить("ЮридическоеФизическоеЛицо", ?(СтрДлина(СокрЛП(Данные.ИНН)) = 12,
			Перечисления.ЮридическоеФизическоеЛицо.ФизическоеЛицо,
			Перечисления.ЮридическоеФизическоеЛицо.ЮридическоеЛицо));
		Значения.Вставить("СтранаРегистрации", Справочники.СтраныМира.Россия);
	ИначеЕсли Вид = "Договор" Тогда
		Значения.Вставить("Владелец", Данные.Контрагент);
		Значения.Вставить("Организация", Данные.Организация);
		Значения.Вставить("ВидДоговора", Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком);
		Если ПустаяСтрока(Данные.Номер) Тогда
			Значения.Вставить("Наименование", НСтр("ru = 'Основной договор'"));
		Иначе
			Значения.Вставить("Номер", СокрЛП(Данные.Номер));
			Значения.Вставить("Наименование", СтрШаблон(НСтр("ru = 'Договор № %1%2'"), СокрЛП(Данные.Номер),
				?(ЗначениеЗаполнено(Данные.Дата), " " + НСтр("ru = 'от'") + " " + Формат(Данные.Дата, "ДЛФ=D"), "")));
		КонецЕсли;
		Если ЗначениеЗаполнено(Данные.Дата) Тогда
			Значения.Вставить("Дата", Данные.Дата);
		КонецЕсли;
	ИначеЕсли Вид = "Номенклатура" Тогда
		Значения.Вставить("Наименование", Лев(СокрЛП(Данные.Наименование), 100));
		Значения.Вставить("НаименованиеПолное", СокрЛП(Данные.Наименование));
		Значения.Вставить("Услуга", Данные.ЭтоУслуга);
		Если ЗначениеЗаполнено(Данные.ЕдиницаИзмерения) Тогда
			Значения.Вставить("ЕдиницаИзмерения", Данные.ЕдиницаИзмерения);
		КонецЕсли;
	КонецЕсли;
	Возврат Значения;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Один HTTP-запрос к сервису. Ошибку соединения не выбрасывает, а возвращает текстом.
//
// Возвращаемое значение:
//   Структура - Код (Число), Текст (Строка), Данные (ДвоичныеДанные), Ошибка (Строка).
//
Функция ВыполнитьЗапрос(Адрес, Порт, Метод, Путь, Тело = Неопределено, ТипТела = "",
	Таймаут = 30, ДвоичныйОтвет = Ложь)

	Ответ = Новый Структура("Код, Текст, Данные, Ошибка", 0, "", Неопределено, "");
	Попытка
		Соединение = Новый HTTPСоединение(Адрес, Порт, , , , Таймаут);
		Запрос = Новый HTTPЗапрос(Путь);
		Запрос.Заголовки.Вставить("Accept", ?(ДвоичныйОтвет, "image/png", "application/json"));
		Если Тело <> Неопределено Тогда
			Запрос.Заголовки.Вставить("Content-Type", ТипТела);
			Если ТипЗнч(Тело) = Тип("ДвоичныеДанные") Тогда
				Запрос.УстановитьТелоИзДвоичныхДанных(Тело);
			Иначе
				Запрос.УстановитьТелоИзСтроки(Тело, КодировкаТекста.UTF8,
					ИспользованиеByteOrderMark.НеИспользовать);
			КонецЕсли;
		КонецЕсли;
		Если Метод = "POST" Тогда
			ОтветHTTP = Соединение.ОтправитьДляОбработки(Запрос);
		Иначе
			ОтветHTTP = Соединение.Получить(Запрос);
		КонецЕсли;
	Исключение
		Ответ.Ошибка = СтрШаблон(
			НСтр("ru = 'Сервис docai не отвечает по адресу http://%1:%2. Запущен ли он? В PowerShell из папки проекта: .\scripts\start.ps1 (%3)'"),
			Адрес, Формат(Порт, "ЧГ=0"), КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Ответ;
	КонецПопытки;

	Ответ.Код = ОтветHTTP.КодСостояния;
	Если ДвоичныйОтвет И Ответ.Код = 200 Тогда
		Ответ.Данные = ОтветHTTP.ПолучитьТелоКакДвоичныеДанные();
	Иначе
		Ответ.Текст = ОтветHTTP.ПолучитьТелоКакСтроку("UTF-8");
	КонецЕсли;
	Возврат Ответ;

КонецФункции

// Текст ошибки из ответа сервиса: {"detail": "..."} или тело как есть.
Функция ТекстОшибкиСервиса(Ответ)

	Подробности = Ответ.Текст;
	Попытка
		Ошибка = РазобратьJSON(Ответ.Текст);
		Если ТипЗнч(Ошибка) = Тип("Структура") И Ошибка.Свойство("detail") Тогда
			Подробности = ?(ТипЗнч(Ошибка.detail) = Тип("Строка"), Ошибка.detail, ЗаписатьВJSON(Ошибка.detail));
		КонецЕсли;
	Исключение
		// Тело не JSON: показываем как есть.
		Подробности = Ответ.Текст;
	КонецПопытки;
	Возврат СтрШаблон(НСтр("ru = 'Сервис ответил кодом %1: %2'"), Формат(Ответ.Код, "ЧГ=0"), Подробности);

КонецФункции

// Имя файла для заголовка Content-Disposition: без кавычек и переводов строк.
Функция ИмяДляЗаголовка(ИмяФайла)

	Имя = СтрЗаменить(ИмяФайла, """", "'");
	Имя = СтрЗаменить(Имя, Символы.ВК, " ");
	Имя = СтрЗаменить(Имя, Символы.ПС, " ");
	Возврат Имя;

КонецФункции

// Название части пути поля: seller -> «Продавец», inn -> «ИНН». Неизвестная -> Неопределено.
Функция ПредставлениеЧасти(Часть)

	Названия = Новый Соответствие;
	Названия.Вставить("doc_type", НСтр("ru = 'Вид документа'"));
	Названия.Вставить("number", НСтр("ru = 'Номер'"));
	Названия.Вставить("date", НСтр("ru = 'Дата'"));
	Названия.Вставить("upd_status", НСтр("ru = 'Статус УПД'"));
	Названия.Вставить("seller", НСтр("ru = 'Продавец'"));
	Названия.Вставить("buyer", НСтр("ru = 'Покупатель'"));
	Названия.Вставить("seller_bank", НСтр("ru = 'Банк продавца'"));
	Названия.Вставить("totals", НСтр("ru = 'Итого'"));
	Названия.Вставить("basis", НСтр("ru = 'Основание'"));
	Названия.Вставить("name", НСтр("ru = 'наименование'"));
	Названия.Вставить("inn", НСтр("ru = 'ИНН'"));
	Названия.Вставить("kpp", НСтр("ru = 'КПП'"));
	Названия.Вставить("address", НСтр("ru = 'адрес'"));
	Названия.Вставить("bank_name", НСтр("ru = 'банк'"));
	Названия.Вставить("bik", НСтр("ru = 'БИК'"));
	Названия.Вставить("corr_account", НСтр("ru = 'корр. счёт'"));
	Названия.Вставить("account", НСтр("ru = 'расчётный счёт'"));
	Названия.Вставить("amount_without_vat", НСтр("ru = 'сумма без НДС'"));
	Названия.Вставить("vat_amount", НСтр("ru = 'НДС'"));
	Названия.Вставить("amount_with_vat", НСтр("ru = 'сумма с НДС'"));
	Возврат Названия.Получить(Часть);

КонецФункции

#Область СопоставлениеСлужебные

// Пакет из четырёх запросов: организации, контрагенты с ИНН продавца, единицы измерения по коду
// и наименованию, номенклатура — точные наименования строк и похожие по основам слов.
Функция ТекстЗапросаСопоставления(ЧислоОснов)

	Условия = Новый Массив;
	Условия.Добавить("Номенклатура.Наименование В (&Наименования)");
	Для Индекс = 0 По ЧислоОснов - 1 Цикл
		Условия.Добавить("Номенклатура.Наименование ПОДОБНО &Основа" + Формат(Индекс, "ЧН=0; ЧГ=0")
			+ " СПЕЦСИМВОЛ ""~""");
	КонецЦикла;

	Возврат
	"ВЫБРАТЬ
	|	Организации.Ссылка КАК Ссылка,
	|	Организации.ИНН КАК ИНН,
	|	Организации.КПП КАК КПП
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|	НЕ Организации.ПометкаУдаления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Контрагенты.Ссылка КАК Ссылка,
	|	Контрагенты.КПП КАК КПП
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.ИНН = &ИННПродавца
	|	И &ИННПродавца <> """"
	|	И НЕ Контрагенты.ЭтоГруппа
	|	И НЕ Контрагенты.ПометкаУдаления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Единицы.Ссылка КАК Ссылка,
	|	Единицы.Код КАК Код,
	|	Единицы.Наименование КАК Наименование
	|ИЗ
	|	Справочник.КлассификаторЕдиницИзмерения КАК Единицы
	|ГДЕ
	|	НЕ Единицы.ПометкаУдаления
	|	И (Единицы.Код В (&КодыЕдиниц)
	|		ИЛИ Единицы.Наименование В (&НаименованияЕдиниц))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 500
	|	Номенклатура.Ссылка КАК Ссылка,
	|	Номенклатура.Наименование КАК Наименование,
	|	Номенклатура.Услуга КАК Услуга,
	|	Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	НЕ Номенклатура.ЭтоГруппа
	|	И НЕ Номенклатура.ПометкаУдаления
	|	И (" + СтрСоединить(Условия, Символы.ПС + "		ИЛИ ") + ")";

КонецФункции

// Организация — покупатель документа: по ИНН (и КПП, если организаций с этим ИНН несколько).
// Если ИНН не совпал, берётся основная организация пользователя — с пометкой «проверьте».
Процедура ВыбратьОрганизацию(Результат, Организации, Реквизиты)

	ИНН = СокрЛП(Реквизиты.ИННПокупателя);
	КПП = СокрЛП(Реквизиты.КПППокупателя);
	Найденные = Новый Массив;
	Если Не ПустаяСтрока(ИНН) Тогда
		Для Каждого Организация Из Организации Цикл
			Если СокрЛП(Организация.ИНН) = ИНН Тогда
				Найденные.Добавить(Организация);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Если Найденные.Количество() > 0 Тогда
		Результат.Организация = Найденные[0].Ссылка;
		Для Каждого Организация Из Найденные Цикл
			Если СокрЛП(Организация.КПП) = КПП Тогда
				Результат.Организация = Организация.Ссылка;
			КонецЕсли;
		КонецЦикла;
		Результат.УровеньОрганизации = 0;
		Результат.СостояниеОрганизации = НСтр("ru = 'найдена по ИНН покупателя'");
		Возврат;
	КонецЕсли;

	Основная = БухгалтерскийУчетПереопределяемый.ПолучитьЗначениеПоУмолчанию("ОсновнаяОрганизация");
	Если Не ЗначениеЗаполнено(Основная) И Организации.Количество() = 1 Тогда
		Основная = Организации[0].Ссылка;
	КонецЕсли;
	Если ЗначениеЗаполнено(Основная) Тогда
		Результат.Организация = Основная;
		Результат.УровеньОрганизации = 1;
		Результат.СостояниеОрганизации = СтрШаблон(
			НСтр("ru = 'ИНН покупателя %1 не совпал ни с одной организацией; взята основная — проверьте'"),
			?(ПустаяСтрока(ИНН), НСтр("ru = '(не распознан)'"), ИНН));
	Иначе
		Результат.СостояниеОрганизации = НСтр("ru = 'организация не найдена — выберите'");
	КонецЕсли;

КонецПроцедуры

// Контрагент — продавец документа: по ИНН, при нескольких с одним ИНН — по КПП.
Процедура ВыбратьКонтрагента(Результат, Контрагенты, Реквизиты)

	КПП = СокрЛП(Реквизиты.КПППродавца);
	Если ПустаяСтрока(Реквизиты.ИННПродавца) Тогда
		Результат.СостояниеКонтрагента = НСтр("ru = 'ИНН продавца не распознан — выберите контрагента'");
		Возврат;
	ИначеЕсли Контрагенты.Количество() = 0 Тогда
		Результат.СостояниеКонтрагента = НСтр("ru = 'с таким ИНН в 1С нет — создайте'");
		Возврат;
	КонецЕсли;

	ПоКПП = Контрагенты.НайтиСтроки(Новый Структура("КПП", КПП));
	Если ПоКПП.Количество() > 0 Тогда
		Результат.Контрагент = ПоКПП[0].Ссылка;
		Результат.УровеньКонтрагента = 0;
		Результат.СостояниеКонтрагента = НСтр("ru = 'найден по ИНН и КПП'");
	ИначеЕсли Контрагенты.Количество() = 1 Тогда
		Результат.Контрагент = Контрагенты[0].Ссылка;
		Результат.УровеньКонтрагента = ?(ПустаяСтрока(КПП) Или ПустаяСтрока(Контрагенты[0].КПП), 0, 1);
		Результат.СостояниеКонтрагента = ?(Результат.УровеньКонтрагента = 0,
			НСтр("ru = 'найден по ИНН'"),
			СтрШаблон(НСтр("ru = 'найден по ИНН, КПП в 1С другой: %1 — проверьте'"), Контрагенты[0].КПП));
	Иначе
		Результат.СостояниеКонтрагента = СтрШаблон(
			НСтр("ru = 'с этим ИНН контрагентов: %1, КПП не совпал — выберите'"), Контрагенты.Количество());
	КонецЕсли;

КонецПроцедуры

// Номенклатура строки: точное совпадение наименования (без учёта регистра, кавычек и пробелов)
// или до пяти похожих по общим основам слов. Похожие не подставляются: выбирает человек.
Функция СопоставитьСтроку(СтрокаДокумента, Номенклатура, Единицы, ЭтоАкт)

	Результат = Новый Структура;
	Результат.Вставить("Номенклатура", Справочники.Номенклатура.ПустаяСсылка());
	Результат.Вставить("ЕдиницаИзмерения", НайтиЕдиницу(Единицы, СтрокаДокумента.КодЕдИзм, СтрокаДокумента.ЕдИзм));
	Результат.Вставить("ЭтоУслуга", ЭтоАкт);
	Результат.Вставить("Уровень", 2);
	Результат.Вставить("Состояние", "");
	Результат.Вставить("Похожие", Новый Массив);

	Нормализованное = НормализованноеНаименование(СтрокаДокумента.Наименование);
	Если ПустаяСтрока(Нормализованное) Тогда
		Результат.Состояние = НСтр("ru = 'наименование не распознано — выберите'");
		Возврат Результат;
	КонецЕсли;
	ОсновыСтроки = ОсновыНаименования(СтрокаДокумента.Наименование);

	Кандидаты = Новый ТаблицаЗначений;
	Кандидаты.Колонки.Добавить("Элемент");
	Кандидаты.Колонки.Добавить("Сходство", Новый ОписаниеТипов("Число"));
	Для Каждого Элемент Из Номенклатура Цикл
		Если Элемент.Нормализованное = Нормализованное Тогда
			Результат.Номенклатура = Элемент.Ссылка;
			Результат.ЭтоУслуга = Элемент.Услуга;
			Если Не ЗначениеЗаполнено(Результат.ЕдиницаИзмерения) Тогда
				Результат.ЕдиницаИзмерения = Элемент.ЕдиницаИзмерения;
			КонецЕсли;
			Результат.Уровень = 0;
			Результат.Состояние = НСтр("ru = 'найдена по наименованию'");
			Возврат Результат;
		КонецЕсли;
		Мера = Сходство(ОсновыСтроки, Элемент.Основы);
		Если Мера >= 0.3 Тогда
			Кандидат = Кандидаты.Добавить();
			Кандидат.Элемент = Элемент;
			Кандидат.Сходство = Мера;
		КонецЕсли;
	КонецЦикла;

	Кандидаты.Сортировать("Сходство Убыв");
	Для Каждого Кандидат Из Кандидаты Цикл
		Если Результат.Похожие.Количество() = 5 Тогда
			Прервать;
		КонецЕсли;
		Результат.Похожие.Добавить(Новый Структура("Ссылка, Наименование, Сходство",
			Кандидат.Элемент.Ссылка, Кандидат.Элемент.Наименование, Кандидат.Сходство));
	КонецЦикла;

	Если Результат.Похожие.Количество() > 0 Тогда
		Результат.Уровень = 1;
		Результат.Состояние = СтрШаблон(НСтр("ru = 'похожих: %1 — выберите или создайте новую'"),
			Результат.Похожие.Количество());
	Иначе
		Результат.Состояние = НСтр("ru = 'не найдена — создайте'");
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Единица измерения: по коду ОКЕИ (796 — шт), иначе по краткому наименованию.
Функция НайтиЕдиницу(Единицы, Код, Наименование)

	Для Каждого Единица Из Единицы Цикл
		Если ЗначениеЗаполнено(Код) И СокрЛП(Единица.Код) = СокрЛП(Код) Тогда
			Возврат Единица.Ссылка;
		КонецЕсли;
	КонецЦикла;
	Для Каждого Единица Из Единицы Цикл
		Если ЗначениеЗаполнено(Наименование) И НРег(СокрЛП(Единица.Наименование)) = НРег(СокрЛП(Наименование)) Тогда
			Возврат Единица.Ссылка;
		КонецЕсли;
	КонецЦикла;
	Возврат Справочники.КлассификаторЕдиницИзмерения.ПустаяСсылка();

КонецФункции

// Наименование без регистра, кавычек, знаков препинания и лишних пробелов: «Скотч "Standard"»
// и «скотч standard» — одно и то же.
Функция НормализованноеНаименование(Наименование)

	Если Не ЗначениеЗаполнено(Наименование) Тогда
		Возврат "";
	КонецЕсли;
	Текст = СтрЗаменить(НРег(Наименование), "ё", "е");
	Разделители = "«»""'`.,;:!?()[]{}/\|-–—№+*=_";
	Для Индекс = 1 По СтрДлина(Разделители) Цикл
		Текст = СтрЗаменить(Текст, Сред(Разделители, Индекс, 1), " ");
	КонецЦикла;
	Слова = СтрРазделить(Текст, " " + Символы.Таб + Символы.ПС, Ложь);
	Возврат СтрСоединить(Слова, " ");

КонецФункции

// Основы слов наименования: первые пять букв слова длиной от трёх букв — грубое отсечение
// окончаний («скотча», «скотч» -> «скотч»). Числа и слова с цифрами берутся целиком.
Функция ОсновыНаименования(Наименование)

	Основы = Новый Массив;
	Для Каждого Слово Из СтрРазделить(НормализованноеНаименование(Наименование), " ", Ложь) Цикл
		Если СтрДлина(Слово) < 3 Тогда
			Продолжить;
		КонецЕсли;
		Основа = ?(ЕстьЦифры(Слово), Слово, Лев(Слово, 5));
		Если Основы.Найти(Основа) = Неопределено Тогда
			Основы.Добавить(Основа);
		КонецЕсли;
	КонецЦикла;
	Возврат Основы;

КонецФункции

// Основы для отбора кандидатов запросом: из всех строк документа, не короче четырёх символов.
Функция ОсновыСтрок(Строки)

	Основы = Новый Массив;
	Для Каждого СтрокаДокумента Из Строки Цикл
		Для Каждого Основа Из ОсновыНаименования(СтрокаДокумента.Наименование) Цикл
			Если СтрДлина(Основа) >= 4 И Основы.Найти(Основа) = Неопределено И Основы.Количество() < 30 Тогда
				Основы.Добавить(Основа);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Основы;

КонецФункции

// Доля общих основ (коэффициент Жаккара): 1 — набор слов совпал, 0 — общих слов нет.
Функция Сходство(Первые, Вторые)

	Если Первые.Количество() = 0 Или Вторые.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;
	Общих = 0;
	Для Каждого Основа Из Первые Цикл
		Если Вторые.Найти(Основа) <> Неопределено Тогда
			Общих = Общих + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Общих / (Первые.Количество() + Вторые.Количество() - Общих);

КонецФункции

Функция ЕстьЦифры(Слово)

	Для Индекс = 1 По СтрДлина(Слово) Цикл
		Если СтрНайти("0123456789", Сред(Слово, Индекс, 1)) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Непустые значения поля строк документа — для параметров запроса «В (...)».
Функция ЗначенияСтрок(Строки, Поле)

	Значения = Новый Массив;
	Для Каждого СтрокаДокумента Из Строки Цикл
		Значение = СокрЛП(СтрокаДокумента[Поле]);
		Если Не ПустаяСтрока(Значение) И Значения.Найти(Значение) = Неопределено Тогда
			Значения.Добавить(Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат Значения;

КонецФункции

// Спецсимволы ПОДОБНО экранируются символом «~» (в запросе — СПЕЦСИМВОЛ "~").
Функция ЭкранироватьДляПодобно(Текст)

	Результат = Текст;
	Для Каждого Символ Из СтрРазделить("~,%,_,[,],^", ",") Цикл
		Результат = СтрЗаменить(Результат, Символ, "~" + Символ);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Номер договора для сравнения: без «№», «N», пробелов и регистра.
Функция НормализованныйНомер(Номер)

	Если Не ЗначениеЗаполнено(Номер) Тогда
		Возврат "";
	КонецЕсли;
	Текст = НРег(СокрЛП(Номер));
	Если СтрНачинаетсяС(Текст, "n ") Или СтрНачинаетсяС(Текст, "n.") Тогда
		Текст = Сред(Текст, 3);
	КонецЕсли;
	Для Каждого Символ Из СтрРазделить("№, ,	", ",") Цикл
		Текст = СтрЗаменить(Текст, Символ, "");
	КонецЦикла;
	Возврат Текст;

КонецФункции

