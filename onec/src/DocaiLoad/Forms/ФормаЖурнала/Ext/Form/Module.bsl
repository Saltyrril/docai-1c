// Журнал загрузки (P16, часть 3): какие документы 1С созданы из каких файлов. Документы
// находятся по метке «[docai]» в начале комментария — её ставит обработка при создании
// (модуль объекта, КомментарийДокумента): «[docai] файл: <имя>; задание: <идентификатор>».

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ЗаполнитьЖурнал();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыЖурнал

&НаКлиенте
Процедура ЖурналВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	СтрокаЖурнала = Журнал.НайтиПоИдентификатору(ВыбраннаяСтрока);
	Если СтрокаЖурнала <> Неопределено И ЗначениеЗаполнено(СтрокаЖурнала.Документ) Тогда
		ПоказатьЗначение(, СтрокаЖурнала.Документ);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОбновитьЖурнал(Команда)

	ЗаполнитьЖурнал();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьЖурнал()

	// Комментарий — строка неограниченной длины: сравнивается её начало.
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Поступления.Ссылка КАК Документ,
	|	Поступления.Дата КАК Дата,
	|	Поступления.Проведен КАК Проведен,
	|	Поступления.Контрагент КАК Контрагент,
	|	Поступления.СуммаДокумента КАК Сумма,
	|	ПОДСТРОКА(Поступления.Комментарий, 1, 300) КАК Комментарий
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг КАК Поступления
	|ГДЕ
	|	ПОДСТРОКА(Поступления.Комментарий, 1, 7) = &Метка
	|	И НЕ Поступления.ПометкаУдаления
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Счета.Ссылка,
	|	Счета.Дата,
	|	Счета.Проведен,
	|	Счета.Контрагент,
	|	Счета.СуммаДокумента,
	|	ПОДСТРОКА(Счета.Комментарий, 1, 300)
	|ИЗ
	|	Документ.СчетНаОплатуПоставщика КАК Счета
	|ГДЕ
	|	ПОДСТРОКА(Счета.Комментарий, 1, 7) = &Метка
	|	И НЕ Счета.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ";
	Запрос.УстановитьПараметр("Метка", "[docai]");

	Журнал.Очистить();
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрокаЖурнала = Журнал.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаЖурнала, Выборка);
		СтрокаЖурнала.Файл = СокрЛП(Сред(Выборка.Комментарий, 8));
	КонецЦикла;
	Заголовок = СтрШаблон(НСтр("ru = 'Журнал загрузки документов (%1)'"), Журнал.Количество());

КонецПроцедуры

#КонецОбласти
