// Главная форма обработки «Загрузка первичных документов (ИИ)» (шаг P16).
//
// Человек выбирает файлы (PDF, PNG, JPEG, XML из ЭДО), обработка отправляет их в сервис docai
// и раз в 2 секунды спрашивает состояние заданий. Готовый документ открывается в форме
// проверки (ФормаПроверки). Список загрузок, адрес и порт сохраняются между сеансами
// в хранилище общих настроек пользователя; незавершённые задания после открытия формы
// опрашиваются снова.

&НаКлиенте
Перем ФайлАвтопроверки;

&НаКлиенте
Перем ПутьФайлаАвтопроверки;

&НаКлиенте
Перем ИдЗаданияАвтопроверки;

&НаКлиенте
Перем ОсталосьОжидатьАвтопроверки;

&НаКлиенте
Перем ОтчетАвтопроверки;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	НастроитьУсловноеОформление();
	ВосстановитьСписок();

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	// Адрес и порт восстанавливаются из настроек; при первом открытии пусты.
	Если ПустаяСтрока(Адрес) Тогда
		Адрес = "127.0.0.1";
	КонецЕсли;
	Если Порт = 0 Тогда
		Порт = 8000;
	КонецЕсли;

	// Автопроверка для scripts\onec_smoke.ps1: 1С запускается с параметром
	// /C "docai-load-smoke=<файл результата>|<файл документа>". При обычном открытии не срабатывает.
	Префикс = "docai-load-smoke=";
	Если СтрНачинаетсяС(ПараметрЗапуска, Префикс) Тогда
		Части = СтрРазделить(Сред(ПараметрЗапуска, СтрДлина(Префикс) + 1), "|");
		ФайлАвтопроверки = Части[0];
		ПутьФайлаАвтопроверки = ?(Части.Количество() > 1, Части[1], "");
		ОтчетАвтопроверки = "";
		ПодключитьОбработчикОжидания("НачатьАвтопроверку", 1, Истина);
		Возврат;
	КонецЕсли;

	ПодключитьОбработчикОжидания("ПроверитьСвязьПриОткрытии", 0.1, Истина);
	ЗапуститьОпрос();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыЗагрузки

&НаКлиенте
Процедура ЗагрузкиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ОткрытьПроверку(ВыбраннаяСтрока);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗагрузитьФайлы(Команда)

	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.МножественныйВыбор = Истина;
	Диалог.Заголовок = НСтр("ru = 'Выберите первичные документы'");
	Диалог.Фильтр = НСтр("ru = 'Документы (PDF, сканы, XML из ЭДО)|*.pdf;*.png;*.jpg;*.jpeg;*.xml|Все файлы|*.*'");

	// Файлы передаются на сервер 1С через временное хранилище: так обработка работает
	// и в клиент-серверной базе, где у сервера нет доступа к диску пользователя.
	Оповещение = Новый ОписаниеОповещения("ЗагрузитьФайлыЗавершение", ЭтотОбъект);
	НачатьПомещениеФайлов(Оповещение, , Диалог, Истина, УникальныйИдентификатор);

КонецПроцедуры

&НаКлиенте
Процедура Проверить(Команда)

	ТекущиеДанные = Элементы.Загрузки.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите строку в списке загруженных файлов.'"));
		Возврат;
	КонецЕсли;
	ОткрытьПроверку(ТекущиеДанные.ПолучитьИдентификатор());

КонецПроцедуры

&НаКлиенте
Процедура Обновить(Команда)

	ОпроситьЗаданияНаСервере(Истина);
	ЗапуститьОпрос();

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьСвязь(Команда)

	СостояниеСервиса = ОписаниеСостоянияСервиса(Адрес, Порт);
	СохранитьСписокНаСервере();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ОтправкаФайлов

&НаКлиенте
Процедура ЗагрузитьФайлыЗавершение(ПомещенныеФайлы, ДополнительныеПараметры) Экспорт

	Если ПомещенныеФайлы = Неопределено Или ПомещенныеФайлы.Количество() = 0 Тогда
		Если ФайлАвтопроверки <> Неопределено Тогда
			ЗакончитьАвтопроверку(СтрШаблон(НСтр("ru = 'Файл не передан на сервер 1С: %1'"), ПутьФайлаАвтопроверки));
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Файлы = Новый Массив;
	Для Каждого Описание Из ПомещенныеФайлы Цикл
		Файлы.Добавить(Новый Структура("Имя, Адрес", ИмяБезПути(Описание.Имя), Описание.Хранение));
	КонецЦикла;

	Состояние(НСтр("ru = 'Отправка файлов в сервис docai...'"));
	Идентификаторы = ОтправитьФайлыНаСервере(Файлы);
	Если ФайлАвтопроверки <> Неопределено Тогда
		ИдЗаданияАвтопроверки = Идентификаторы[0];
		Если ПустаяСтрока(ИдЗаданияАвтопроверки) Тогда
			ЗакончитьАвтопроверку("== Загрузка ==" + Символы.ПС
				+ ОписаниеСтрокиЗагрузки(Загрузки[Загрузки.Количество() - 1]));
			Возврат;
		КонецЕсли;
	КонецЕсли;
	ЗапуститьОпрос();

КонецПроцедуры

// Отправляет файлы из временного хранилища и добавляет строки в список загрузок.
// Возвращает идентификаторы заданий (пустая строка — файл не принят).
&НаСервере
Функция ОтправитьФайлыНаСервере(Знач Файлы)

	Обработка = РеквизитФормыВЗначение("Объект");
	Идентификаторы = Новый Массив;
	Для Каждого ОписаниеФайла Из Файлы Цикл
		ДанныеФайла = ПолучитьИзВременногоХранилища(ОписаниеФайла.Адрес);
		УдалитьИзВременногоХранилища(ОписаниеФайла.Адрес);

		СтрокаЗагрузки = Загрузки.Добавить();
		СтрокаЗагрузки.ИмяФайла = ОписаниеФайла.Имя;
		Результат = Обработка.ОтправитьФайл(Адрес, Порт, ДанныеФайла, ОписаниеФайла.Имя);
		Если Результат.Успех Тогда
			СтрокаЗагрузки.ИдЗадания = Результат.ИдЗадания;
			СтрокаЗагрузки.Состояние = "queued";
			СтрокаЗагрузки.СостояниеТекст = Обработка.ПредставлениеОчереди(Результат.ВОчереди);
		Иначе
			СтрокаЗагрузки.Состояние = "error";
			СтрокаЗагрузки.СостояниеТекст = НСтр("ru = 'Не отправлен'");
			СтрокаЗагрузки.Замечания = Результат.Ошибка;
		КонецЕсли;
		Идентификаторы.Добавить(СтрокаЗагрузки.ИдЗадания);
	КонецЦикла;
	ОбновитьПрогресс();
	СохранитьСписок();
	Возврат Идентификаторы;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ИмяБезПути(ПолноеИмя)

	Части = СтрРазделить(СтрЗаменить(ПолноеИмя, "/", "\"), "\");
	Возврат Части[Части.ВГраница()];

КонецФункции

#КонецОбласти

#Область ОпросЗаданий

&НаКлиенте
Процедура ЗапуститьОпрос()

	ОтключитьОбработчикОжидания("ОпроситьЗадания");
	Если ЕстьНезавершенныеЗадания() Тогда
		ПодключитьОбработчикОжидания("ОпроситьЗадания", 2, Ложь);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОпроситьЗадания()

	ОпроситьЗаданияНаСервере(Ложь);
	Если Не ЕстьНезавершенныеЗадания() Тогда
		ОтключитьОбработчикОжидания("ОпроситьЗадания");
	КонецЕсли;
	Если ФайлАвтопроверки <> Неопределено Тогда
		ПродолжитьАвтопроверку();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция ЕстьНезавершенныеЗадания()

	Для Каждого СтрокаЗагрузки Из Загрузки Цикл
		Если ЗаданиеНезавершено(СтрокаЗагрузки.Состояние) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЗаданиеНезавершено(Состояние)

	Возврат Состояние = "queued" Или Состояние = "running";

КонецФункции

// Спрашивает у сервиса состояние незавершённых заданий (или всех, если ВсеЗадания).
&НаСервере
Процедура ОпроситьЗаданияНаСервере(ВсеЗадания)

	Обработка = РеквизитФормыВЗначение("Объект");
	Для Каждого СтрокаЗагрузки Из Загрузки Цикл
		Если ПустаяСтрока(СтрокаЗагрузки.ИдЗадания) Тогда
			Продолжить;
		КонецЕсли;
		Если Не ВсеЗадания И Не ЗаданиеНезавершено(СтрокаЗагрузки.Состояние) Тогда
			Продолжить;
		КонецЕсли;
		Ответ = Обработка.ПолучитьЗадание(Адрес, Порт, СтрокаЗагрузки.ИдЗадания);
		Если Ответ.Успех Тогда
			ЗаполнитьСтрокуЗагрузки(СтрокаЗагрузки, Ответ.Данные, Обработка);
		ИначеЕсли Ответ.Код = 404 Тогда
			// Сервис не знает задание (например, удалили data\service): опрашивать дальше незачем.
			СтрокаЗагрузки.Состояние = "error";
			СтрокаЗагрузки.СостояниеТекст = НСтр("ru = 'Задание не найдено в сервисе'");
			СтрокаЗагрузки.Замечания = Ответ.Ошибка;
		Иначе
			// Сервис временно недоступен: состояние не меняем, опрос продолжится.
			СтрокаЗагрузки.Замечания = Ответ.Ошибка;
		КонецЕсли;
	КонецЦикла;
	ОбновитьПрогресс();
	СохранитьСписок();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСтрокуЗагрузки(СтрокаЗагрузки, Данные, Обработка)

	СтрокаЗагрузки.Состояние = Данные.status;
	СтрокаЗагрузки.СостояниеТекст = Обработка.ПредставлениеСостояния(Данные);
	Если Данные.status = "failed" Тогда
		СтрокаЗагрузки.Замечания = Данные.error;
		Возврат;
	ИначеЕсли Данные.status <> "done" Тогда
		Возврат;
	КонецЕсли;

	Значения = Обработка.ЗначенияПолей(Данные);
	СтрокаЗагрузки.КодВида = Данные.doc_type;
	СтрокаЗагрузки.ВидДокумента = Обработка.ПредставлениеВидаДокумента(Данные.doc_type, Данные.upd_status);
	СтрокаЗагрузки.СтатусДокумента = Данные.document_status;
	СтрокаЗагрузки.Номер = Значения.Получить("number");
	СтрокаЗагрузки.Дата = ДатаИзСтроки(Значения.Получить("date"));
	СтрокаЗагрузки.Продавец = Значения.Получить("seller.name");
	СтрокаЗагрузки.Сумма = ЧислоИзСтроки(Значения.Получить("totals.amount_with_vat"));
	Если ТипЗнч(Данные.status_reasons) = Тип("Массив") Тогда
		СтрокаЗагрузки.Замечания = СтрСоединить(Данные.status_reasons, "; ");
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ОбновитьПрогресс()

	Всего = Загрузки.Количество();
	Готово = 0;
	Ждут = 0;
	Ошибок = 0;
	Для Каждого СтрокаЗагрузки Из Загрузки Цикл
		Если СтрокаЗагрузки.Состояние = "done" Тогда
			Готово = Готово + 1;
		ИначеЕсли ЗаданиеНезавершено(СтрокаЗагрузки.Состояние) Тогда
			Ждут = Ждут + 1;
		Иначе
			Ошибок = Ошибок + 1;
		КонецЕсли;
	КонецЦикла;

	Если Всего = 0 Тогда
		Прогресс = НСтр("ru = 'Нажмите «Загрузить файлы...» и выберите PDF, сканы или XML из ЭДО.'");
	Иначе
		Прогресс = СтрШаблон(НСтр("ru = 'Файлов: %1. Распознано: %2, ждут или распознаются: %3, ошибок: %4.%5'"),
			Всего, Готово, Ждут, Ошибок,
			?(Ждут > 0, НСтр("ru = ' Документ распознаётся 15–40 секунд, по одному.'"), ""));
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область Проверка

&НаКлиенте
Процедура ОткрытьПроверку(ИдентификаторСтроки, Автопроверка = Ложь)

	СтрокаЗагрузки = Загрузки.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если СтрокаЗагрузки.Состояние <> "done" Тогда
		ПоказатьПредупреждение(, СтрШаблон(НСтр("ru = 'Документ ещё не распознан: %1.'"),
			СтрокаЗагрузки.СостояниеТекст));
		Возврат;
	КонецЕсли;

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ИдЗадания", СтрокаЗагрузки.ИдЗадания);
	ПараметрыФормы.Вставить("Адрес", Адрес);
	ПараметрыФормы.Вставить("Порт", Порт);
	ПараметрыФормы.Вставить("ИмяФайла", СтрокаЗагрузки.ИмяФайла);
	ПараметрыФормы.Вставить("Правки", СтрокаЗагрузки.Правки);
	ПараметрыФормы.Вставить("Автопроверка", Автопроверка);

	Оповещение = Новый ОписаниеОповещения("ПроверкаЗавершение", ЭтотОбъект, ИдентификаторСтроки);
	// Форма проверки открывается во весь рабочий стол (не диалогом): ей нужно место под
	// страницу документа и таблицы. Один документ — одна форма (уникальность по заданию).
	ОткрытьФорму(ИмяСоседнейФормы("ФормаПроверки"), ПараметрыФормы, ЭтотОбъект,
		СтрокаЗагрузки.ИдЗадания, , , Оповещение, РежимОткрытияОкнаФормы.Независимый);

КонецПроцедуры

// Результат формы проверки: Структура с правками или Неопределено, если закрыли без сохранения.
&НаКлиенте
Процедура ПроверкаЗавершение(Результат, ИдентификаторСтроки) Экспорт

	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	СтрокаЗагрузки = Загрузки.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если СтрокаЗагрузки <> Неопределено Тогда
		СтрокаЗагрузки.Правки = Результат.Правки;
		СтрокаЗагрузки.Проверено = Истина;
		СтрокаЗагрузки.Замечания = Результат.Итог;
	КонецЕсли;
	СохранитьСписокНаСервере();
	Если ФайлАвтопроверки <> Неопределено Тогда
		ЗакончитьАвтопроверку(Результат.Отчет);
	КонецЕсли;

КонецПроцедуры

// Полное имя другой формы этой же обработки. Имя обработки не зашито в код: обработку
// могут открыть из файла под другим именем.
&НаКлиенте
Функция ИмяСоседнейФормы(ИмяФормыОбработки)

	Части = СтрРазделить(ИмяФормы, ".");
	Части[Части.ВГраница()] = ИмяФормыОбработки;
	Возврат СтрСоединить(Части, ".");

КонецФункции

#КонецОбласти

#Область СостояниеСервиса

&НаКлиенте
Процедура ПроверитьСвязьПриОткрытии()

	СостояниеСервиса = ОписаниеСостоянияСервиса(Адрес, Порт);
	ОбновитьПрогрессНаСервере();

КонецПроцедуры

&НаСервере
Функция ОписаниеСостоянияСервиса(Знач АдресСервиса, Знач ПортСервиса)

	Возврат РеквизитФормыВЗначение("Объект").ОписаниеСостоянияСервиса(АдресСервиса, ПортСервиса);

КонецФункции

&НаСервере
Процедура ОбновитьПрогрессНаСервере()

	ОбновитьПрогресс();

КонецПроцедуры

#КонецОбласти

#Область Автопроверка

// Автопроверка (scripts\onec_smoke.ps1): отправить файл без диалога, дождаться распознавания,
// открыть форму проверки, отправить правки, записать отчёт и закрыть 1С.
&НаКлиенте
Процедура НачатьАвтопроверку()

	ОсталосьОжидатьАвтопроверки = 300;
	СостояниеСервиса = ОписаниеСостоянияСервиса(Адрес, Порт);
	Если ПустаяСтрока(ПутьФайлаАвтопроверки) Тогда
		ЗакончитьАвтопроверку(НСтр("ru = 'Не указан файл документа для автопроверки.'"));
		Возврат;
	КонецЕсли;

	Файлы = Новый Массив;
	Файлы.Добавить(Новый ОписаниеПередаваемогоФайла(ПутьФайлаАвтопроверки, ""));
	Оповещение = Новый ОписаниеОповещения("ЗагрузитьФайлыЗавершение", ЭтотОбъект);
	НачатьПомещениеФайлов(Оповещение, Файлы, , Ложь, УникальныйИдентификатор);

КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьАвтопроверку()

	СтрокаЗагрузки = Неопределено;
	Для Каждого Кандидат Из Загрузки Цикл
		Если ЗначениеЗаполнено(ИдЗаданияАвтопроверки) И Кандидат.ИдЗадания = ИдЗаданияАвтопроверки Тогда
			СтрокаЗагрузки = Кандидат;
		КонецЕсли;
	КонецЦикла;
	Если СтрокаЗагрузки = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ОсталосьОжидатьАвтопроверки = ОсталосьОжидатьАвтопроверки - 2;
	Если СтрокаЗагрузки.Состояние = "done" Тогда
		ФайлАвтопроверкиДобавить("== Загрузка ==" + Символы.ПС + ОписаниеСтрокиЗагрузки(СтрокаЗагрузки));
		ОткрытьПроверку(СтрокаЗагрузки.ПолучитьИдентификатор(), Истина);
		ИдЗаданияАвтопроверки = Неопределено;
	ИначеЕсли Не ЗаданиеНезавершено(СтрокаЗагрузки.Состояние) Или ОсталосьОжидатьАвтопроверки <= 0 Тогда
		ЗакончитьАвтопроверку("== Загрузка ==" + Символы.ПС + ОписаниеСтрокиЗагрузки(СтрокаЗагрузки));
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция ОписаниеСтрокиЗагрузки(СтрокаЗагрузки)

	Возврат СтрШаблон("Сервис: %1
		|Файл: %2
		|Задание: %3
		|Состояние: %4 (%5)
		|Вид: %6
		|Номер: %7
		|Сумма: %8
		|Замечания: %9",
		СостояниеСервиса, СтрокаЗагрузки.ИмяФайла, СтрокаЗагрузки.ИдЗадания, СтрокаЗагрузки.Состояние,
		СтрокаЗагрузки.СостояниеТекст, СтрокаЗагрузки.ВидДокумента, СтрокаЗагрузки.Номер,
		Формат(СтрокаЗагрузки.Сумма, "ЧРД=.; ЧГ=0"), СтрокаЗагрузки.Замечания);

КонецФункции

&НаКлиенте
Процедура ФайлАвтопроверкиДобавить(Текст)

	ОтчетАвтопроверки = ?(ОтчетАвтопроверки = "", "", ОтчетАвтопроверки + Символы.ПС + Символы.ПС) + Текст;

КонецПроцедуры

&НаКлиенте
Процедура ЗакончитьАвтопроверку(Текст)

	ФайлАвтопроверкиДобавить(Текст);
	ЗаписатьФайлАвтопроверки(ФайлАвтопроверки, ОтчетАвтопроверки);
	ЗавершитьРаботуСистемы(Ложь);

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаписатьФайлАвтопроверки(Знач Путь, Знач Текст)

	Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8);
	Запись.Записать(Текст);
	Запись.Закрыть();

КонецПроцедуры

#КонецОбласти

#Область СохранениеСписка

// Ключ объекта в хранилище общих настроек: список хранится у каждого пользователя свой.
&НаСервереБезКонтекста
Функция КлючНастроек()

	Возврат "docai.DocaiLoad";

КонецФункции

&НаСервере
Процедура СохранитьСписок()

	Таблица = РеквизитФормыВЗначение("Загрузки");
	Настройки = Новый Структура("Адрес, Порт, Загрузки", Адрес, Порт, Таблица);
	ХранилищеОбщихНастроек.Сохранить(КлючНастроек(), "Список", Настройки);

КонецПроцедуры

&НаСервере
Процедура СохранитьСписокНаСервере()

	СохранитьСписок();

КонецПроцедуры

// Строки копируются по именам колонок: после изменения состава колонок старый список
// всё равно откроется, недостающие значения останутся пустыми.
&НаСервере
Процедура ВосстановитьСписок()

	Настройки = ХранилищеОбщихНастроек.Загрузить(КлючНастроек(), "Список");
	Если ТипЗнч(Настройки) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	Если Настройки.Свойство("Адрес") Тогда
		Адрес = Настройки.Адрес;
	КонецЕсли;
	Если Настройки.Свойство("Порт") Тогда
		Порт = Настройки.Порт;
	КонецЕсли;
	Если Настройки.Свойство("Загрузки") И ТипЗнч(Настройки.Загрузки) = Тип("ТаблицаЗначений") Тогда
		Для Каждого Сохраненная Из Настройки.Загрузки Цикл
			ЗаполнитьЗначенияСвойств(Загрузки.Добавить(), Сохраненная);
		КонецЦикла;
	КонецЕсли;
	ОбновитьПрогресс();

КонецПроцедуры

#КонецОбласти

#Область Оформление

&НаСервере
Процедура НастроитьУсловноеОформление()

	// Отклонённые и неудачные задания — красным текстом, требующие проверки — тёмно-жёлтым.
	ДобавитьОформление("СтатусДокумента", "reject", Новый Цвет(192, 0, 0));
	ДобавитьОформление("Состояние", "failed", Новый Цвет(192, 0, 0));
	ДобавитьОформление("Состояние", "error", Новый Цвет(192, 0, 0));
	ДобавитьОформление("СтатусДокумента", "review", Новый Цвет(150, 110, 0));

КонецПроцедуры

&НаСервере
Процедура ДобавитьОформление(Колонка, Значение, ЦветТекста)

	Элемент = УсловноеОформление.Элементы.Добавить();
	Поле = Элемент.Поля.Элементы.Добавить();
	Поле.Поле = Новый ПолеКомпоновкиДанных(Элементы.ЗагрузкиСостояниеТекст.Имя);
	Отбор = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Загрузки." + Колонка);
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Отбор.ПравоеЗначение = Значение;
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветТекста);

КонецПроцедуры

#КонецОбласти

#Область Преобразования

&НаКлиентеНаСервереБезКонтекста
Функция ДатаИзСтроки(Значение)

	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;
	Попытка
		Возврат Дата(СтрЗаменить(Лев(Значение, 10), "-", ""));
	Исключение
		// Дата в документе не распознана или записана не в ISO: оставляем пустой.
		Возврат Дата(1, 1, 1);
	КонецПопытки;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЧислоИзСтроки(Значение)

	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат 0;
	КонецЕсли;
	Попытка
		Возврат Число(СтрЗаменить(Значение, ",", "."));
	Исключение
		// Не число (модель вернула текст): показываем 0, исходное значение видно в форме проверки.
		Возврат 0;
	КонецПопытки;

КонецФункции

#КонецОбласти

#КонецОбласти
