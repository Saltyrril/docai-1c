// Форма проверки распознанного документа (шаг P16).
//
// Слева — страница документа (PNG из сервиса), справа — реквизиты, внизу — строки таблицы.
// Подсветка: жёлтым — модель не уверена (needs_review) или предупреждение проверки,
// красным — ошибка проверки (issues с severity = error), зелёным — значение исправил человек.
// Причина подсветки — в колонке «Замечание». Любое значение можно исправить.
//
// «Готово» отправляет все значения формы в сервис (POST /v1/jobs/{id}/feedback) и возвращает
// их владельцу: при повторном открытии правки накладываются на результат распознавания.
//
// Значения хранятся так, как их отдаёт сервис (даты ISO, числа с точкой), а показываются
// по-русски (14.11.2026, 2462,06). Уровни подсветки: 0 — нет, 1 — жёлтый, 2 — красный, 3 — зелёный.
//
// Блок «Справочники 1С» (часть 2): организация, контрагент и договор подбираются по реквизитам
// документа, номенклатура строк — по наименованию с выбором из похожих. Не найденное можно
// создать: открывается стандартная форма элемента, заполненная из документа; после записи
// элемент подставляется сюда по оповещению формы (D58).

&НаКлиенте
Перем ОжидаемоеСоздание; // "Контрагент" или "Договор": ждём оповещение о записи нового элемента

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ИдЗадания = Параметры.ИдЗадания;
	Адрес = Параметры.Адрес;
	Порт = Параметры.Порт;
	ИмяФайла = Параметры.ИмяФайла;
	Автопроверка = Параметры.Автопроверка;
	Заголовок = СтрШаблон(НСтр("ru = 'Проверка документа: %1'"), ИмяФайла);

	НастроитьУсловноеОформление();
	ЗагрузитьДокумент(Параметры.Правки);

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	Если Автопроверка Тогда
		ПодключитьОбработчикОжидания("ВыполнитьАвтопроверку", 0.5, Истина);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	// Формы элементов Бухгалтерии после записи оповещают «Запись_<Справочник>» со ссылкой.
	Если ИмяСобытия = "Запись_Контрагенты" И ОжидаемоеСоздание = "Контрагент" Тогда
		ОжидаемоеСоздание = Неопределено;
		Контрагент = Источник;
		ОтметитьВыборВручную("Контрагент", НСтр("ru = 'создан'"));
		ПодобратьДоговорНаСервере();
	ИначеЕсли ИмяСобытия = "Запись_ДоговорыКонтрагентов" И ОжидаемоеСоздание = "Договор" Тогда
		ОжидаемоеСоздание = Неопределено;
		Договор = Источник;
		ОтметитьВыборВручную("Договор", НСтр("ru = 'создан'"));
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)

	ОтметитьВыборВручную("Организация", НСтр("ru = 'выбрана вручную'"));
	ПодобратьДоговорНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура КонтрагентПриИзменении(Элемент)

	ОтметитьВыборВручную("Контрагент", НСтр("ru = 'выбран вручную'"));
	ПодобратьДоговорНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ДоговорПриИзменении(Элемент)

	ОтметитьВыборВручную("Договор", НСтр("ru = 'выбран вручную'"));

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыПоля

&НаКлиенте
Процедура ПоляЗначениеПриИзменении(Элемент)

	ТекущиеДанные = Элементы.Поля.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ОбновитьУровеньПоля(ТекущиеДанные);
	Если ПолеВлияетНаСопоставление(ТекущиеДанные.Имя) Тогда
		СопоставитьШапкуНаСервере();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСтроки

&НаКлиенте
Процедура СтрокиПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)

	Если ОтменаРедактирования Тогда
		Возврат;
	КонецЕсли;
	ПеренумероватьСтроки();
	ТекущиеДанные = Элементы.Строки.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		ОбновитьУровниСтроки(ТекущиеДанные, Исходные);
	КонецЕсли;

КонецПроцедуры

// Если для строки нашлись похожие позиции, сначала предлагаются они, затем справочник и создание.
&НаКлиенте
Процедура СтрокиНоменклатураНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	ТекущиеДанные = Элементы.Строки.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ИдентификаторСтроки = ТекущиеДанные.ПолучитьИдентификатор();
	Найденные = Похожие.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки));
	Если Найденные.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	СтандартнаяОбработка = Ложь;
	Список = Новый СписокЗначений;
	Для Каждого Похожая Из Найденные Цикл
		Список.Добавить(Похожая.Номенклатура, Похожая.Наименование + " (" + НСтр("ru = 'сходство'") + " "
			+ Формат(Похожая.Сходство * 100, "ЧДЦ=0; ЧН=0") + "%)");
	КонецЦикла;
	Список.Добавить("Справочник", НСтр("ru = 'Выбрать из справочника...'"));
	Список.Добавить("Создать", НСтр("ru = 'Создать новую номенклатуру...'"));
	Оповещение = Новый ОписаниеОповещения("СтрокиНоменклатураВыборЗавершение", ЭтотОбъект,
		Новый Структура("ИдентификаторСтроки, Элемент", ИдентификаторСтроки, Элемент));
	ПоказатьВыборИзСписка(Оповещение, Список, Элемент);

КонецПроцедуры

&НаКлиенте
Процедура СтрокиНоменклатураПриИзменении(Элемент)

	ТекущиеДанные = Элементы.Строки.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		ПослеВыбораНоменклатуры(ТекущиеДанные, НСтр("ru = 'выбрана вручную'"));
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СтрокиПослеУдаления(Элемент)

	ПеренумероватьСтроки();
	Для Каждого СтрокаТаблицы Из Строки Цикл
		ОбновитьУровниСтроки(СтрокаТаблицы, Исходные);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Готово(Команда)

	Результат = ОтправитьПравкиНаСервере();
	ВозвращаемоеЗначение = Новый Структура("Правки, Итог, Отчет", Результат.Правки, Результат.Итог, "");
	Если Результат.Успех Тогда
		Закрыть(ВозвращаемоеЗначение);
		Возврат;
	КонецЕсли;

	// Правки остаются в списке загрузок 1С, даже если сервис их не принял.
	Оповещение = Новый ОписаниеОповещения("ГотовоЗавершение", ЭтотОбъект, ВозвращаемоеЗначение);
	ПоказатьПредупреждение(Оповещение, СтрШаблон(
		НСтр("ru = 'Правки сохранены в списке загрузок, но сервис их не принял:
		|%1
		|Их можно отправить позже: откройте документ и нажмите «Отправить правки».'"), Результат.Ошибка));

КонецПроцедуры

&НаКлиенте
Процедура ГотовоЗавершение(ВозвращаемоеЗначение) Экспорт

	Закрыть(ВозвращаемоеЗначение);

КонецПроцедуры

&НаКлиенте
Процедура ОтправитьПравки(Команда)

	Результат = ОтправитьПравкиНаСервере();
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = ?(Результат.Успех, Результат.Итог, Результат.Ошибка);
	Сообщение.Сообщить();

КонецПроцедуры

&НаКлиенте
Процедура СоздатьКонтрагента(Команда)

	ОжидаемоеСоздание = "Контрагент";
	ОткрытьФорму("Справочник.Контрагенты.ФормаОбъекта",
		Новый Структура("ЗначенияЗаполнения", ЗначенияЗаполненияНаСервере("Контрагент")), ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура СоздатьДоговор(Команда)

	Если Не ЗначениеЗаполнено(Контрагент) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Сначала выберите или создайте контрагента: договор принадлежит ему.'"));
		Возврат;
	КонецЕсли;
	Значения = ЗначенияЗаполненияНаСервере("Договор");
	ФормаДоговора = ПолучитьФорму("Справочник.ДоговорыКонтрагентов.ФормаОбъекта",
		Новый Структура("ЗначенияЗаполнения", Значения), ЭтотОбъект);
	// У реквизитов «Номер» и «Дата» договора снят флаг «Заполнять из данных заполнения»:
	// ЗаполнениеДокументов.ЗаполнитьПоСтруктуре их пропускает. Ставим их в открываемой форме (D58).
	Если Значения.Свойство("Номер") Тогда
		ФормаДоговора.Объект.Номер = Значения.Номер;
	КонецЕсли;
	Если Значения.Свойство("Дата") Тогда
		ФормаДоговора.Объект.Дата = Значения.Дата;
	КонецЕсли;
	ОжидаемоеСоздание = "Договор";
	ФормаДоговора.Открыть();

КонецПроцедуры

&НаКлиенте
Процедура СоздатьНоменклатуру(Команда)

	ТекущиеДанные = Элементы.Строки.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите строку на вкладке «Товары и услуги».'"));
		Возврат;
	КонецЕсли;
	ОткрытьФормуНовойНоменклатуры(ТекущиеДанные.ПолучитьИдентификатор());

КонецПроцедуры

&НаКлиенте
Процедура ПредыдущаяСтраница(Команда)

	ПоказатьСтраницу(Страница - 1);

КонецПроцедуры

&НаКлиенте
Процедура СледующаяСтраница(Команда)

	ПоказатьСтраницу(Страница + 1);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ЗагрузкаДокумента

&НаСервере
Процедура ЗагрузитьДокумент(Знач Правки)

	Обработка = РеквизитФормыВЗначение("Объект");
	Ответ = Обработка.ПолучитьЗадание(Адрес, Порт, ИдЗадания);
	Если Не Ответ.Успех Тогда
		Сводка = Ответ.Ошибка;
		ПоказатьСтраницуНаСервере(0, Обработка);
		Возврат;
	КонецЕсли;

	Данные = Ответ.Данные;
	ЗаполнитьИсходные(Данные);
	ЗаполнитьПоляИСтроки(Обработка);
	СохраненныеПравки = ?(ЗначениеЗаполнено(Правки), Обработка.РазобратьJSON(Правки, Истина), Неопределено);
	Если СохраненныеПравки <> Неопределено Тогда
		ПрименитьПравки(СохраненныеПравки);
	КонецЕсли;
	Сопоставить(Обработка, Истина);
	Если СохраненныеПравки <> Неопределено Тогда
		ПрименитьСопоставление(СохраненныеПравки);
	КонецЕсли;
	ЗаполнитьСводку(Данные, Обработка);
	Элементы.СтраницаСтроки.Заголовок = СтрШаблон(НСтр("ru = 'Товары и услуги (%1)'"), Строки.Количество());

	ВсегоСтраниц = ?(Данные.preview_pages = Неопределено, 0, Данные.preview_pages);
	ПоказатьСтраницуНаСервере(1, Обработка);

КонецПроцедуры

// Все значения документа в том виде, как их отдал сервис, с уровнем подсветки и замечанием.
&НаСервере
Процедура ЗаполнитьИсходные(Данные)

	Ошибки = Новый Соответствие;
	Предупреждения = Новый Соответствие;
	Для Каждого Проблема Из Данные.issues Цикл
		Если Проблема.field <> Неопределено Тогда
			ДобавитьЗамечание(?(Проблема.severity = "error", Ошибки, Предупреждения),
				Проблема.field, Проблема.message);
		КонецЕсли;
	КонецЦикла;

	Исправления = Новый Соответствие;
	Для Каждого Исправление Из Данные.corrections Цикл
		Если Исправление.kind = "autofix" Тогда
			ДобавитьЗамечание(Исправления, Исправление.field, СтрШаблон(
				НСтр("ru = 'исправлено автоматически (было %1): %2'"), Исправление.before, Исправление.reason));
		КонецЕсли;
	КонецЦикла;

	Исходные.Очистить();
	Для Каждого Поле Из Данные.fields Цикл
		Если ЭтоСоставноеПоле(Поле.name) Тогда
			Продолжить;
		КонецЕсли;
		Исходная = Исходные.Добавить();
		Исходная.Имя = Поле.name;
		Исходная.Значение = ?(Поле.value = Неопределено, "", Поле.value);
		Уверенность = ЧислоИзСтроки(Поле.confidence);
		Если Ошибки.Получить(Поле.name) <> Неопределено Тогда
			Исходная.Уровень = 2;
			Исходная.Замечание = Ошибки.Получить(Поле.name);
		ИначеЕсли Предупреждения.Получить(Поле.name) <> Неопределено Тогда
			Исходная.Уровень = 1;
			Исходная.Замечание = Предупреждения.Получить(Поле.name);
		ИначеЕсли Поле.needs_review = Истина Тогда
			Исходная.Уровень = 1;
			Исходная.Замечание = СтрШаблон(НСтр("ru = 'модель не уверена: %1'"),
				Формат(Уверенность, "ЧДЦ=2; ЧН=0"));
		КонецЕсли;
		Если Исправления.Получить(Поле.name) <> Неопределено Тогда
			Исходная.Замечание = ?(Исходная.Замечание = "", "", Исходная.Замечание + "; ")
				+ Исправления.Получить(Поле.name);
		КонецЕсли;
	КонецЦикла;

	// Ошибка может относиться к полю, которого нет в списке (модель его не нашла).
	Для Каждого Ошибка Из Ошибки Цикл
		Если Исходные.НайтиСтроки(Новый Структура("Имя", Ошибка.Ключ)).Количество() = 0 Тогда
			Исходная = Исходные.Добавить();
			Исходная.Имя = Ошибка.Ключ;
			Исходная.Уровень = 2;
			Исходная.Замечание = Ошибка.Значение;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Поля шапки и строки таблицы из исходных значений.
&НаСервере
Процедура ЗаполнитьПоляИСтроки(Обработка)

	Поля.Очистить();
	Строки.Очистить();
	Для Каждого Исходная Из Исходные Цикл
		Индекс = ИндексСтроки(Исходная.Имя);
		Если Индекс = Неопределено Тогда
			СтрокаПоля = Поля.Добавить();
			СтрокаПоля.Имя = Исходная.Имя;
			СтрокаПоля.Представление = Обработка.ПредставлениеПоля(Исходная.Имя);
			СтрокаПоля.Значение = ДляЧеловека(Исходная.Имя, Исходная.Значение);
			СтрокаПоля.Исходное = Исходная.Значение;
			СтрокаПоля.УровеньИсходный = Исходная.Уровень;
			СтрокаПоля.ЗамечаниеИсходное = Исходная.Замечание;
			Если Исходная.Имя = "doc_type" Тогда
				СтрокаПоля.ЗамечаниеИсходное = ?(Исходная.Замечание = "", "", Исходная.Замечание + "; ")
					+ НСтр("ru = 'upd — УПД, bill — счёт, act — акт, torg12 — ТОРГ-12, vat_invoice — счёт-фактура'");
			КонецЕсли;
			СтрокаПоля.Уровень = СтрокаПоля.УровеньИсходный;
			СтрокаПоля.Замечание = СтрокаПоля.ЗамечаниеИсходное;
		Иначе
			Пока Строки.Количество() <= Индекс Цикл
				НоваяСтрока = Строки.Добавить();
				НоваяСтрока.Индекс = Строки.Количество() - 1;
				НоваяСтрока.Н = Строки.Количество();
			КонецЦикла;
			УстановитьЯчейку(Строки[Индекс], КлючЯчейки(Исходная.Имя), Исходная.Значение);
		КонецЕсли;
	КонецЦикла;

	Для Каждого СтрокаТаблицы Из Строки Цикл
		ОбновитьУровниСтроки(СтрокаТаблицы, Исходные);
	КонецЦикла;

КонецПроцедуры

// Накладывает правки, сохранённые при прошлой проверке этого документа.
//
// Параметры:
//   Правки - Соответствие - values (имя -> значение для сервиса), lines (число строк).
//
&НаСервере
Процедура ПрименитьПравки(Правки)

	Значения = Правки.Получить("values");
	Если ТипЗнч(Значения) <> Тип("Соответствие") Тогда
		Возврат;
	КонецЕсли;

	Для Каждого СтрокаПоля Из Поля Цикл
		Значение = Значения.Получить(СтрокаПоля.Имя);
		СтрокаПоля.Значение = ДляЧеловека(СтрокаПоля.Имя, Значение);
		ОбновитьУровеньПоля(СтрокаПоля);
	КонецЦикла;

	ЧислоСтрок = Правки.Получить("lines");
	Если ЧислоСтрок = Неопределено Тогда
		ЧислоСтрок = Строки.Количество();
	КонецЕсли;
	Пока Строки.Количество() > ЧислоСтрок Цикл
		Строки.Удалить(Строки.Количество() - 1);
	КонецЦикла;
	Пока Строки.Количество() < ЧислоСтрок Цикл
		Строки.Добавить();
	КонецЦикла;

	Колонки = КолонкиСтрок();
	Для Индекс = 0 По Строки.Количество() - 1 Цикл
		СтрокаТаблицы = Строки[Индекс];
		СтрокаТаблицы.Индекс = Индекс;
		СтрокаТаблицы.Н = Индекс + 1;
		Для Каждого Колонка Из Колонки Цикл
			УстановитьЯчейку(СтрокаТаблицы, Колонка.Ключ, Значения.Получить(ИмяЯчейки(Индекс, Колонка.Ключ)));
		КонецЦикла;
		ОбновитьУровниСтроки(СтрокаТаблицы, Исходные);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСводку(Данные, Обработка)

	Значения = Обработка.ЗначенияПолей(Данные);
	ВидДокумента = Обработка.ПредставлениеВидаДокумента(Данные.doc_type, Данные.upd_status);
	Части = Новый Массив;
	Части.Добавить(СтрШаблон(НСтр("ru = '%1 № %2 от %3 — %4'"), ВидДокумента,
		ДляЧеловека("number", Значения.Получить("number")), ДляЧеловека("date", Значения.Получить("date")),
		?(Данные.document_status_ru = Неопределено, Данные.status, Данные.document_status_ru)));

	Если ТипЗнч(Данные.status_reasons) = Тип("Массив") И Данные.status_reasons.Количество() > 0 Тогда
		Части.Добавить(НСтр("ru = 'Причины: '") + СтрСоединить(Данные.status_reasons, "; "));
	КонецЕсли;

	// Замечания без привязки к полю видны только здесь.
	Общие = Новый Массив;
	Для Каждого Проблема Из Данные.issues Цикл
		Если Проблема.field = Неопределено Тогда
			Общие.Добавить(Проблема.message);
		КонецЕсли;
	КонецЦикла;
	Если Общие.Количество() > 0 Тогда
		Части.Добавить(НСтр("ru = 'По документу: '") + СтрСоединить(Общие, "; "));
	КонецЕсли;

	Части.Добавить(СтрШаблон(НСтр("ru = 'Распознано: путь %1, модель %2, %3 с, средняя уверенность %4. Файл: %5'"),
		Данные.route, ?(Данные.model = Неопределено, "—", Данные.model), Данные.seconds,
		?(Данные.mean_confidence = Неопределено, "—", Данные.mean_confidence), ИмяФайла));
	Сводка = СтрСоединить(Части, Символы.ПС);

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ДобавитьЗамечание(Замечания, Имя, Текст)

	Было = Замечания.Получить(Имя);
	Замечания.Вставить(Имя, ?(Было = Неопределено, Текст, Было + "; " + Текст));

КонецПроцедуры

// Пустые составные поля (basis = null) в форме не нужны: их части приходят отдельно.
&НаСервереБезКонтекста
Функция ЭтоСоставноеПоле(Имя)

	Возврат Имя = "basis" Или Имя = "seller_bank" Или Имя = "seller" Или Имя = "buyer" Или Имя = "totals"
		Или Имя = "lines";

КонецФункции

#КонецОбласти

#Область СопоставлениеСоСправочниками

// Реквизиты шапки, от которых зависит сопоставление: после их правки справочники ищутся заново.
&НаКлиентеНаСервереБезКонтекста
Функция ПолеВлияетНаСопоставление(Имя)

	Возврат СтрНайти("|seller.inn|seller.kpp|buyer.inn|buyer.kpp|basis.number|basis.date|doc_type|",
		"|" + Имя + "|") > 0;

КонецФункции

// Ищет организацию, контрагента, договор и (если ВместеСоСтроками) номенклатуру строк.
// Без строк выбор номенклатуры, сделанный человеком, не трогается.
&НаСервере
Процедура Сопоставить(Обработка, ВместеСоСтроками)

	СтрокиДокумента = Новый Массив;
	Если ВместеСоСтроками Тогда
		Для Каждого СтрокаТаблицы Из Строки Цикл
			СтрокиДокумента.Добавить(Новый Структура("Наименование, ЕдИзм, КодЕдИзм",
				СтрокаТаблицы.Наименование, СтрокаТаблицы.ЕдИзм, СтрокаТаблицы.КодЕдИзм));
		КонецЦикла;
	КонецЕсли;
	Результат = Обработка.СопоставитьСоСправочниками(РеквизитыДляСопоставления(), СтрокиДокумента);

	Для Каждого Имя Из СтрРазделить("Организация,Контрагент,Договор", ",") Цикл
		ЭтотОбъект[Имя] = Результат[Имя];
		ЭтотОбъект["Уровень" + Имя] = Результат["Уровень" + ИмяВРезультате(Имя)];
		ЭтотОбъект["Состояние" + Имя] = Результат["Состояние" + ИмяВРезультате(Имя)];
	КонецЦикла;

	Если Не ВместеСоСтроками Тогда
		Возврат;
	КонецЕсли;
	Похожие.Очистить();
	Для Индекс = 0 По Строки.Количество() - 1 Цикл
		СтрокаТаблицы = Строки[Индекс];
		Найдено = Результат.Строки[Индекс];
		СтрокаТаблицы.Номенклатура = Найдено.Номенклатура;
		СтрокаТаблицы.ЕдиницаИзмерения = Найдено.ЕдиницаИзмерения;
		СтрокаТаблицы.ЭтоУслуга = Найдено.ЭтоУслуга;
		СтрокаТаблицы.УровеньНоменклатуры = Найдено.Уровень;
		СтрокаТаблицы.СостояниеНоменклатуры = Найдено.Состояние;
		Для Каждого Похожая Из Найдено.Похожие Цикл
			НоваяПохожая = Похожие.Добавить();
			НоваяПохожая.ИдентификаторСтроки = СтрокаТаблицы.ПолучитьИдентификатор();
			НоваяПохожая.Номенклатура = Похожая.Ссылка;
			НоваяПохожая.Наименование = Похожая.Наименование;
			НоваяПохожая.Сходство = Похожая.Сходство;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// В результате сопоставления ключи в родительном падеже: УровеньОрганизации, СостояниеДоговора.
&НаКлиентеНаСервереБезКонтекста
Функция ИмяВРезультате(Имя)

	Если Имя = "Организация" Тогда
		Возврат "Организации";
	КонецЕсли;
	Возврат Имя + "а";

КонецФункции

&НаСервере
Процедура СопоставитьШапкуНаСервере()

	Сопоставить(РеквизитФормыВЗначение("Объект"), Ложь);

КонецПроцедуры

&НаСервере
Процедура ПодобратьДоговорНаСервере()

	Реквизиты = РеквизитыДляСопоставления();
	Результат = РеквизитФормыВЗначение("Объект").ПодобратьДоговор(Контрагент, Организация,
		Реквизиты.НомерДоговора, Реквизиты.ДатаДоговора);
	Договор = Результат.Договор;
	УровеньДоговор = Результат.Уровень;
	СостояниеДоговор = Результат.Состояние;

КонецПроцедуры

// Значения шапки для сопоставления — уже с правками человека.
&НаСервере
Функция РеквизитыДляСопоставления()

	Реквизиты = Новый Структура;
	Реквизиты.Вставить("ИННПокупателя", ЗначениеПоля("buyer.inn"));
	Реквизиты.Вставить("КПППокупателя", ЗначениеПоля("buyer.kpp"));
	Реквизиты.Вставить("ИННПродавца", ЗначениеПоля("seller.inn"));
	Реквизиты.Вставить("КПППродавца", ЗначениеПоля("seller.kpp"));
	Реквизиты.Вставить("НомерДоговора", ЗначениеПоля("basis.number"));
	Реквизиты.Вставить("ДатаДоговора", ДатаИзISO(ЗначениеПоля("basis.date")));
	Реквизиты.Вставить("ВидДокумента", ЗначениеПоля("doc_type"));
	Возврат Реквизиты;

КонецФункции

// Значение реквизита шапки в виде для сервиса (дата ISO, число с точкой); нет поля — "".
&НаСервере
Функция ЗначениеПоля(Имя)

	Найденные = Поля.НайтиСтроки(Новый Структура("Имя", Имя));
	Если Найденные.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Значение = ДляСервиса(Имя, Найденные[0].Значение);
	Возврат ?(Значение = Неопределено, "", Значение);

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ДатаИзISO(Значение)

	Если СтрДлина(Значение) <> 10 Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;
	Попытка
		Возврат Дата(СтрЗаменить(Значение, "-", ""));
	Исключение
		// Дата не по формату ISO: сопоставляем без неё.
		Возврат Дата(1, 1, 1);
	КонецПопытки;

КонецФункции

&НаКлиенте
Процедура ОтметитьВыборВручную(Имя, Состояние)

	Если ЗначениеЗаполнено(ЭтотОбъект[Имя]) Тогда
		ЭтотОбъект["Уровень" + Имя] = 3;
		ЭтотОбъект["Состояние" + Имя] = Состояние;
	Иначе
		ЭтотОбъект["Уровень" + Имя] = 2;
		ЭтотОбъект["Состояние" + Имя] = НСтр("ru = 'не выбрано'");
	КонецЕсли;

КонецПроцедуры

// Значения заполнения для формы нового элемента справочника — из реквизитов документа.
&НаСервере
Функция ЗначенияЗаполненияНаСервере(Вид, ИдентификаторСтроки = Неопределено)

	Данные = Новый Структура;
	Если Вид = "Контрагент" Тогда
		Данные.Вставить("Наименование", ЗначениеПоля("seller.name"));
		Данные.Вставить("ИНН", ЗначениеПоля("seller.inn"));
		Данные.Вставить("КПП", ЗначениеПоля("seller.kpp"));
	ИначеЕсли Вид = "Договор" Тогда
		Данные.Вставить("Контрагент", Контрагент);
		Данные.Вставить("Организация", Организация);
		Данные.Вставить("Номер", ЗначениеПоля("basis.number"));
		Данные.Вставить("Дата", ДатаИзISO(ЗначениеПоля("basis.date")));
	Иначе
		СтрокаТаблицы = Строки.НайтиПоИдентификатору(ИдентификаторСтроки);
		Данные.Вставить("Наименование", СтрокаТаблицы.Наименование);
		Данные.Вставить("ЭтоУслуга", СтрокаТаблицы.ЭтоУслуга);
		Данные.Вставить("ЕдиницаИзмерения", СтрокаТаблицы.ЕдиницаИзмерения);
	КонецЕсли;
	Возврат РеквизитФормыВЗначение("Объект").ЗначенияЗаполненияНовогоЭлемента(Вид, Данные);

КонецФункции

&НаКлиенте
Процедура ОткрытьФормуНовойНоменклатуры(ИдентификаторСтроки)

	Значения = ЗначенияЗаполненияНаСервере("Номенклатура", ИдентификаторСтроки);
	// Форма номенклатуры при закрытии кладёт созданную ссылку в ДополнительныеПараметры,
	// если это Структура (Справочник.Номенклатура.ФормаЭлемента, ПриЗакрытии).
	Оповещение = Новый ОписаниеОповещения("СоздатьНоменклатуруЗавершение", ЭтотОбъект,
		Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки));
	ОткрытьФорму("Справочник.Номенклатура.ФормаОбъекта", Новый Структура("ЗначенияЗаполнения", Значения),
		ЭтотОбъект, , , , Оповещение);

КонецПроцедуры

&НаКлиенте
Процедура СоздатьНоменклатуруЗавершение(Результат, Параметры) Экспорт

	Если Не Параметры.Свойство("Номенклатура") Или Не ЗначениеЗаполнено(Параметры.Номенклатура) Тогда
		Возврат;
	КонецЕсли;
	СтрокаТаблицы = Строки.НайтиПоИдентификатору(Параметры.ИдентификаторСтроки);
	Если СтрокаТаблицы <> Неопределено Тогда
		СтрокаТаблицы.Номенклатура = Параметры.Номенклатура;
		ПослеВыбораНоменклатуры(СтрокаТаблицы, НСтр("ru = 'создана'"));
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СтрокиНоменклатураВыборЗавершение(ВыбранныйЭлемент, Параметры) Экспорт

	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	ИначеЕсли ВыбранныйЭлемент.Значение = "Справочник" Тогда
		ОткрытьФорму("Справочник.Номенклатура.ФормаВыбора", , Параметры.Элемент);
	ИначеЕсли ВыбранныйЭлемент.Значение = "Создать" Тогда
		ОткрытьФормуНовойНоменклатуры(Параметры.ИдентификаторСтроки);
	Иначе
		СтрокаТаблицы = Строки.НайтиПоИдентификатору(Параметры.ИдентификаторСтроки);
		СтрокаТаблицы.Номенклатура = ВыбранныйЭлемент.Значение;
		ПослеВыбораНоменклатуры(СтрокаТаблицы, НСтр("ru = 'выбрана из похожих'"));
	КонецЕсли;

КонецПроцедуры

// Номенклатуру выбрал человек: признак услуги и единица — из карточки номенклатуры.
&НаКлиенте
Процедура ПослеВыбораНоменклатуры(СтрокаТаблицы, Состояние)

	Если Не ЗначениеЗаполнено(СтрокаТаблицы.Номенклатура) Тогда
		СтрокаТаблицы.УровеньНоменклатуры = 2;
		СтрокаТаблицы.СостояниеНоменклатуры = НСтр("ru = 'не выбрана'");
		Возврат;
	КонецЕсли;
	Реквизиты = РеквизитыНоменклатуры(СтрокаТаблицы.Номенклатура);
	СтрокаТаблицы.ЭтоУслуга = Реквизиты.Услуга;
	Если Не ЗначениеЗаполнено(СтрокаТаблицы.ЕдиницаИзмерения) Тогда
		СтрокаТаблицы.ЕдиницаИзмерения = Реквизиты.ЕдиницаИзмерения;
	КонецЕсли;
	СтрокаТаблицы.УровеньНоменклатуры = 3;
	СтрокаТаблицы.СостояниеНоменклатуры = Состояние;

КонецПроцедуры

&НаСервереБезКонтекста
Функция РеквизитыНоменклатуры(Номенклатура)

	Возврат ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Номенклатура, "Услуга, ЕдиницаИзмерения");

КонецФункции

// Выбор человека (уровень 3) для повторного открытия: ссылки — по уникальному идентификатору.
&НаСервере
Функция СохраняемоеСопоставление()

	Сопоставление = Новый Соответствие;
	Для Каждого Имя Из СтрРазделить("Организация,Контрагент,Договор", ",") Цикл
		Сохраняемое = Новый Соответствие;
		Сохраняемое.Вставить("ref", ИдентификаторСсылки(ЭтотОбъект[Имя]));
		Сохраняемое.Вставить("level", ЭтотОбъект["Уровень" + Имя]);
		Сохраняемое.Вставить("state", ЭтотОбъект["Состояние" + Имя]);
		Сопоставление.Вставить(Имя, Сохраняемое);
	КонецЦикла;

	СтрокиСопоставления = Новый Массив;
	Для Каждого СтрокаТаблицы Из Строки Цикл
		Сохраняемое = Новый Соответствие;
		Сохраняемое.Вставить("ref", ИдентификаторСсылки(СтрокаТаблицы.Номенклатура));
		Сохраняемое.Вставить("unit", ИдентификаторСсылки(СтрокаТаблицы.ЕдиницаИзмерения));
		Сохраняемое.Вставить("service", СтрокаТаблицы.ЭтоУслуга);
		Сохраняемое.Вставить("level", СтрокаТаблицы.УровеньНоменклатуры);
		Сохраняемое.Вставить("state", СтрокаТаблицы.СостояниеНоменклатуры);
		СтрокиСопоставления.Добавить(Сохраняемое);
	КонецЦикла;
	Сопоставление.Вставить("lines", СтрокиСопоставления);
	Возврат Сопоставление;

КонецФункции

// Возвращает выбор, сделанный человеком при прошлой проверке. Найденное автоматически
// не восстанавливается: его даст новое сопоставление по текущему состоянию справочников.
&НаСервере
Процедура ПрименитьСопоставление(Правки)

	Сопоставление = Правки.Получить("match");
	Если ТипЗнч(Сопоставление) <> Тип("Соответствие") Тогда
		Возврат;
	КонецЕсли;

	Менеджеры = Новый Структура("Организация, Контрагент, Договор",
		Справочники.Организации, Справочники.Контрагенты, Справочники.ДоговорыКонтрагентов);
	Для Каждого Менеджер Из Менеджеры Цикл
		Сохраненное = Сопоставление.Получить(Менеджер.Ключ);
		Если ВыборЧеловека(Сохраненное) Тогда
			ЭтотОбъект[Менеджер.Ключ] = СсылкаПоИдентификатору(Менеджер.Значение, Сохраненное.Получить("ref"));
			ЭтотОбъект["Уровень" + Менеджер.Ключ] = 3;
			ЭтотОбъект["Состояние" + Менеджер.Ключ] = Сохраненное.Получить("state");
		КонецЕсли;
	КонецЦикла;

	СтрокиСопоставления = Сопоставление.Получить("lines");
	Если ТипЗнч(СтрокиСопоставления) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;
	Для Индекс = 0 По Мин(СтрокиСопоставления.Количество(), Строки.Количество()) - 1 Цикл
		Сохраненное = СтрокиСопоставления[Индекс];
		Если Не ВыборЧеловека(Сохраненное) Тогда
			Продолжить;
		КонецЕсли;
		СтрокаТаблицы = Строки[Индекс];
		СтрокаТаблицы.Номенклатура = СсылкаПоИдентификатору(Справочники.Номенклатура, Сохраненное.Получить("ref"));
		СтрокаТаблицы.ЕдиницаИзмерения = СсылкаПоИдентификатору(Справочники.КлассификаторЕдиницИзмерения,
			Сохраненное.Получить("unit"));
		СтрокаТаблицы.ЭтоУслуга = (Сохраненное.Получить("service") = Истина);
		СтрокаТаблицы.УровеньНоменклатуры = 3;
		СтрокаТаблицы.СостояниеНоменклатуры = Сохраненное.Получить("state");
	КонецЦикла;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ВыборЧеловека(Сохраненное)

	Возврат ТипЗнч(Сохраненное) = Тип("Соответствие") И Сохраненное.Получить("level") = 3
		И ЗначениеЗаполнено(Сохраненное.Получить("ref"));

КонецФункции

&НаСервереБезКонтекста
Функция ИдентификаторСсылки(Ссылка)

	Возврат ?(ЗначениеЗаполнено(Ссылка), Строка(Ссылка.УникальныйИдентификатор()), "");

КонецФункции

&НаСервереБезКонтекста
Функция СсылкаПоИдентификатору(Менеджер, Идентификатор)

	Если Не ЗначениеЗаполнено(Идентификатор) Тогда
		Возврат Менеджер.ПустаяСсылка();
	КонецЕсли;
	Возврат Менеджер.ПолучитьСсылку(Новый УникальныйИдентификатор(Идентификатор));

КонецФункции

// Итог сопоставления для отчёта автопроверки.
&НаСервере
Функция ОписаниеСопоставления()

	Найдено = 0;
	ПохожихСтрок = 0;
	НеНайдено = 0;
	Для Каждого СтрокаТаблицы Из Строки Цикл
		Если ЗначениеЗаполнено(СтрокаТаблицы.Номенклатура) Тогда
			Найдено = Найдено + 1;
		ИначеЕсли СтрокаТаблицы.УровеньНоменклатуры = 1 Тогда
			ПохожихСтрок = ПохожихСтрок + 1;
		Иначе
			НеНайдено = НеНайдено + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат СтрШаблон("== Сопоставление ==
		|Организация: %1 (%2)
		|Контрагент: %3 (%4)
		|Договор: %5 (%6)
		|Номенклатура: найдена %7, есть похожие %8, не найдена %9",
		Организация, СостояниеОрганизация, Контрагент, СостояниеКонтрагент, Договор, СостояниеДоговор,
		Найдено, ПохожихСтрок, НеНайдено);

КонецФункции

#КонецОбласти

#Область Страницы

&НаКлиенте
Процедура ПоказатьСтраницу(Номер)

	ПоказатьСтраницуНаСервере(Номер);

КонецПроцедуры

&НаСервере
Процедура ПоказатьСтраницуНаСервере(Номер, Обработка = Неопределено)

	Если ВсегоСтраниц = 0 Тогда
		АдресКартинки = "";
		ТекстСтраницы = "";
		Элементы.Картинка.ТекстНевыбраннойКартинки = НСтр("ru = 'Картинки нет: документ пришёл из ЭДО как XML или не загрузился'");
		Элементы.ПредыдущаяСтраница.Доступность = Ложь;
		Элементы.СледующаяСтраница.Доступность = Ложь;
		Возврат;
	КонецЕсли;

	Номер = Макс(1, Мин(Номер, ВсегоСтраниц));
	Если Обработка = Неопределено Тогда
		Обработка = РеквизитФормыВЗначение("Объект");
	КонецЕсли;
	Ответ = Обработка.ПолучитьСтраницу(Адрес, Порт, ИдЗадания, Номер);
	Если Ответ.Успех Тогда
		АдресКартинки = ПоместитьВоВременноеХранилище(Ответ.Данные, УникальныйИдентификатор);
	Иначе
		АдресКартинки = "";
		Элементы.Картинка.ТекстНевыбраннойКартинки = Ответ.Ошибка;
	КонецЕсли;
	Страница = Номер;
	ТекстСтраницы = СтрШаблон(НСтр("ru = 'стр. %1 из %2'"), Номер, ВсегоСтраниц);
	Элементы.ПредыдущаяСтраница.Доступность = Номер > 1;
	Элементы.СледующаяСтраница.Доступность = Номер < ВсегоСтраниц;

КонецПроцедуры

#КонецОбласти

#Область ПодсветкаИПравки

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьУровеньПоля(СтрокаПоля)

	Если ОдинаковыеЗначения(ДляСервиса(СтрокаПоля.Имя, СтрокаПоля.Значение), СтрокаПоля.Исходное) Тогда
		// Вернули исходное значение — возвращается и исходная подсветка.
		СтрокаПоля.Уровень = СтрокаПоля.УровеньИсходный;
		СтрокаПоля.Замечание = СтрокаПоля.ЗамечаниеИсходное;
	Иначе
		СтрокаПоля.Уровень = 3;
		СтрокаПоля.Замечание = СтрШаблон(НСтр("ru = 'исправлено вами, было: %1'"),
			ПредставлениеБывшего(ДляЧеловека(СтрокаПоля.Имя, СтрокаПоля.Исходное)));
	КонецЕсли;

КонецПроцедуры

// Уровни и замечание строки таблицы: сравнение каждой ячейки с тем, что распознал сервис.
&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьУровниСтроки(СтрокаТаблицы, Исходные)

	Замечания = Новый Массив;
	Для Каждого Колонка Из КолонкиСтрок() Цикл
		Значение = ЗначениеЯчейки(СтрокаТаблицы, Колонка);
		Найденные = Исходные.НайтиСтроки(Новый Структура("Имя", ИмяЯчейки(СтрокаТаблицы.Индекс, Колонка.Ключ)));
		Если Найденные.Количество() = 0 Тогда
			Исходная = Новый Структура("Значение, Уровень, Замечание", "", 0, "");
		Иначе
			Исходная = Найденные[0];
		КонецЕсли;

		Если ОдинаковыеЗначения(Значение, Исходная.Значение) Тогда
			Уровень = Исходная.Уровень;
			Замечание = Исходная.Замечание;
		Иначе
			Уровень = 3;
			Замечание = СтрШаблон(НСтр("ru = 'исправлено вами, было: %1'"),
				ПредставлениеБывшего(СтрЗаменить(Исходная.Значение, ".", ",")));
		КонецЕсли;
		СтрокаТаблицы["Уровень" + Колонка.Колонка] = Уровень;
		Если Замечание <> "" Тогда
			Замечания.Добавить(Колонка.Заголовок + ": " + Замечание);
		КонецЕсли;
	КонецЦикла;
	СтрокаТаблицы.Замечание = СтрСоединить(Замечания, "; ");

КонецПроцедуры

&НаКлиенте
Процедура ПеренумероватьСтроки()

	Номер = 0;
	Для Каждого СтрокаТаблицы Из Строки Цикл
		СтрокаТаблицы.Н = Номер + 1;
		СтрокаТаблицы.Индекс = Номер;
		Номер = Номер + 1;
	КонецЦикла;

КонецПроцедуры

// Отправляет все значения формы в сервис и готовит правки для списка загрузок.
//
// Возвращаемое значение:
//   Структура - Успех, Ошибка, Итог (Строка для списка), Правки (Строка JSON), Отчет (Строка).
//
&НаСервере
Функция ОтправитьПравкиНаСервере()

	Обработка = РеквизитФормыВЗначение("Объект");
	Значения = ЗначенияДляСервиса();
	Правки = Новый Соответствие;
	Правки.Вставить("values", Значения);
	Правки.Вставить("lines", Строки.Количество());
	Правки.Вставить("match", СохраняемоеСопоставление());

	Автор = ?(ПустаяСтрока(ИмяПользователя()), НСтр("ru = 'пользователь 1С'"), ИмяПользователя());
	Ответ = Обработка.ОтправитьПравки(Адрес, Порт, ИдЗадания, Значения, Автор);

	Результат = Новый Структура("Успех, Ошибка, Итог, Правки, Отчет", Ответ.Успех, Ответ.Ошибка, "",
		Обработка.ЗаписатьВJSON(Правки), "");
	Если Ответ.Успех Тогда
		Результат.Итог = СтрШаблон(НСтр("ru = 'Проверено: исправлено %1 из %2 значений, правки отправлены в сервис'"),
			Ответ.Изменено, Ответ.Всего);
	Иначе
		Результат.Итог = СтрШаблон(НСтр("ru = 'Проверено, но правки не отправлены: %1'"), Ответ.Ошибка);
	КонецЕсли;
	Результат.Отчет = ОтчетАвтопроверки(Ответ);
	Возврат Результат;

КонецФункции

// Значения формы в виде, который ждёт сервис: имя поля -> строка или Неопределено (null).
&НаСервере
Функция ЗначенияДляСервиса()

	Значения = Новый Соответствие;
	Для Каждого СтрокаПоля Из Поля Цикл
		Значения.Вставить(СтрокаПоля.Имя, ДляСервиса(СтрокаПоля.Имя, СтрокаПоля.Значение));
	КонецЦикла;

	Колонки = КолонкиСтрок();
	Для Индекс = 0 По Строки.Количество() - 1 Цикл
		Для Каждого Колонка Из Колонки Цикл
			Значение = ЗначениеЯчейки(Строки[Индекс], Колонка);
			Значения.Вставить(ИмяЯчейки(Индекс, Колонка.Ключ), ?(Значение = "", Неопределено, Значение));
		КонецЦикла;
	КонецЦикла;

	// Строки, которые человек удалил: их значения стали пустыми.
	Для Каждого Исходная Из Исходные Цикл
		Индекс = ИндексСтроки(Исходная.Имя);
		Если Индекс <> Неопределено И Индекс >= Строки.Количество() Тогда
			Значения.Вставить(Исходная.Имя, Неопределено);
		КонецЕсли;
	КонецЦикла;
	Возврат Значения;

КонецФункции

#КонецОбласти

#Область ЯчейкиСтрок

// Колонки таблицы «Строки» и ключи строки документа в ответе сервиса (lines[i].<ключ>).
&НаКлиентеНаСервереБезКонтекста
Функция КолонкиСтрок()

	Колонки = Новый Массив;
	ДобавитьКолонку(Колонки, "Наименование", "name", НСтр("ru = 'наименование'"), Ложь);
	ДобавитьКолонку(Колонки, "ЕдИзм", "unit_name", НСтр("ru = 'ед.'"), Ложь);
	ДобавитьКолонку(Колонки, "КодЕдИзм", "unit_code", НСтр("ru = 'код ед.'"), Ложь);
	ДобавитьКолонку(Колонки, "Количество", "quantity", НСтр("ru = 'количество'"), Истина);
	ДобавитьКолонку(Колонки, "Цена", "price", НСтр("ru = 'цена'"), Истина);
	ДобавитьКолонку(Колонки, "СуммаБезНДС", "amount_without_vat", НСтр("ru = 'сумма без НДС'"), Истина);
	ДобавитьКолонку(Колонки, "СтавкаНДС", "vat_rate", НСтр("ru = 'ставка НДС'"), Ложь);
	ДобавитьКолонку(Колонки, "СуммаНДС", "vat_amount", НСтр("ru = 'НДС'"), Истина);
	ДобавитьКолонку(Колонки, "СуммаСНДС", "amount_with_vat", НСтр("ru = 'сумма с НДС'"), Истина);
	Возврат Колонки;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ДобавитьКолонку(Колонки, Колонка, Ключ, Заголовок, ЭтоЧисло)

	Колонки.Добавить(Новый Структура("Колонка, Ключ, Заголовок, ЭтоЧисло", Колонка, Ключ, Заголовок, ЭтоЧисло));

КонецПроцедуры

// Значение ячейки строкой, как его ждёт сервис: число с точкой, пустая строка — нет значения.
&НаКлиентеНаСервереБезКонтекста
Функция ЗначениеЯчейки(СтрокаТаблицы, Колонка)

	Значение = СтрокаТаблицы[Колонка.Колонка];
	Если Колонка.ЭтоЧисло Тогда
		Возврат ?(Значение = 0, "", Формат(Значение, "ЧРД=.; ЧГ=0"));
	КонецЕсли;
	Возврат СокрЛП(Значение);

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьЯчейку(СтрокаТаблицы, Ключ, Значение)

	Для Каждого Колонка Из КолонкиСтрок() Цикл
		Если Колонка.Ключ = Ключ Тогда
			Если Колонка.ЭтоЧисло Тогда
				СтрокаТаблицы[Колонка.Колонка] = ЧислоИзСтроки(Значение);
			Иначе
				СтрокаТаблицы[Колонка.Колонка] = ?(Значение = Неопределено, "", Значение);
			КонецЕсли;
			Возврат;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ИмяЯчейки(Индекс, Ключ)

	Возврат "lines[" + Формат(Индекс, "ЧН=0; ЧГ=0") + "]." + Ключ;

КонецФункции

// Индекс строки из имени поля lines[3].price -> 3; для полей шапки — Неопределено.
&НаКлиентеНаСервереБезКонтекста
Функция ИндексСтроки(Имя)

	Если Не СтрНачинаетсяС(Имя, "lines[") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Конец = СтрНайти(Имя, "]");
	Если Конец = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Возврат Число(Сред(Имя, 7, Конец - 7));
	Исключение
		// Имя не по формату сервиса: считаем полем шапки.
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция КлючЯчейки(Имя)

	Возврат Сред(Имя, СтрНайти(Имя, "].") + 2);

КонецФункции

#КонецОбласти

#Область Преобразования

// Значение сервиса -> вид для человека: дата 14.11.2026, сумма 2462,06, пустое — "".
&НаКлиентеНаСервереБезКонтекста
Функция ДляЧеловека(Имя, Значение)

	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Если ЭтоПолеДаты(Имя) И СтрДлина(Значение) = 10 И Сред(Значение, 5, 1) = "-" Тогда
		Возврат Сред(Значение, 9, 2) + "." + Сред(Значение, 6, 2) + "." + Лев(Значение, 4);
	ИначеЕсли ЭтоПолеСуммы(Имя) Тогда
		Возврат СтрЗаменить(Значение, ".", ",");
	КонецЕсли;
	Возврат Значение;

КонецФункции

// Вид для человека -> значение для сервиса: дата ISO, число с точкой, пустое — Неопределено.
&НаКлиентеНаСервереБезКонтекста
Функция ДляСервиса(Имя, Значение)

	Текст = СокрЛП(Значение);
	Если Текст = "" Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если ЭтоПолеДаты(Имя) И СтрДлина(Текст) = 10 И Сред(Текст, 3, 1) = "." И Сред(Текст, 6, 1) = "." Тогда
		Возврат Прав(Текст, 4) + "-" + Сред(Текст, 4, 2) + "-" + Лев(Текст, 2);
	ИначеЕсли ЭтоПолеСуммы(Имя) Тогда
		Возврат СтрЗаменить(СтрЗаменить(Текст, " ", ""), ",", ".");
	КонецЕсли;
	Возврат Текст;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЭтоПолеДаты(Имя)

	Возврат Имя = "date" Или СтрЗаканчиваетсяНа(Имя, ".date");

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЭтоПолеСуммы(Имя)

	Возврат СтрНачинаетсяС(Имя, "totals.");

КонецФункции

// Значения совпадают: пустые равны, числа сравниваются как числа («10» = «10.00»), как в сервисе.
&НаКлиентеНаСервереБезКонтекста
Функция ОдинаковыеЗначения(Первое, Второе)

	Левое = ?(Первое = Неопределено, "", СокрЛП(Первое));
	Правое = ?(Второе = Неопределено, "", СокрЛП(Второе));
	Если Левое = Правое Тогда
		Возврат Истина;
	КонецЕсли;
	Попытка
		Возврат Число(Левое) = Число(Правое);
	Исключение
		// Хотя бы одно значение не число: строки уже сравнили.
		Возврат Ложь;
	КонецПопытки;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЧислоИзСтроки(Значение)

	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат 0;
	КонецЕсли;
	Попытка
		Возврат Число(СтрЗаменить(Значение, ",", "."));
	Исключение
		// Не число (модель вернула текст): ячейка остаётся пустой и подсвечивается как исправленная.
		Возврат 0;
	КонецПопытки;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПредставлениеБывшего(Значение)

	Возврат ?(ПустаяСтрока(Значение), НСтр("ru = '(пусто)'"), Значение);

КонецФункции

#КонецОбласти

#Область Оформление

&НаСервере
Процедура НастроитьУсловноеОформление()

	Желтый = Новый Цвет(255, 242, 170);
	Красный = Новый Цвет(255, 199, 199);
	Зеленый = Новый Цвет(208, 240, 208);

	Для Каждого ИмяЭлемента Из СтрРазделить("ПоляПредставление,ПоляЗначение,ПоляЗамечание", ",") Цикл
		ДобавитьОформление(ИмяЭлемента, "Поля.Уровень", 1, Желтый);
		ДобавитьОформление(ИмяЭлемента, "Поля.Уровень", 2, Красный);
		ДобавитьОформление(ИмяЭлемента, "Поля.Уровень", 3, Зеленый);
	КонецЦикла;
	Для Каждого Имя Из СтрРазделить("Организация,Контрагент,Договор", ",") Цикл
		ДобавитьОформление(Имя, "Уровень" + Имя, 1, Желтый);
		ДобавитьОформление(Имя, "Уровень" + Имя, 2, Красный);
		ДобавитьОформление(Имя, "Уровень" + Имя, 3, Зеленый);
	КонецЦикла;
	Для Каждого ИмяЭлемента Из СтрРазделить("СтрокиНоменклатура,СтрокиСостояниеНоменклатуры", ",") Цикл
		ДобавитьОформление(ИмяЭлемента, "Строки.УровеньНоменклатуры", 1, Желтый);
		ДобавитьОформление(ИмяЭлемента, "Строки.УровеньНоменклатуры", 2, Красный);
		ДобавитьОформление(ИмяЭлемента, "Строки.УровеньНоменклатуры", 3, Зеленый);
	КонецЦикла;
	Для Каждого Колонка Из КолонкиСтрок() Цикл
		ДобавитьОформление("Строки" + Колонка.Колонка, "Строки.Уровень" + Колонка.Колонка, 1, Желтый);
		ДобавитьОформление("Строки" + Колонка.Колонка, "Строки.Уровень" + Колонка.Колонка, 2, Красный);
		ДобавитьОформление("Строки" + Колонка.Колонка, "Строки.Уровень" + Колонка.Колонка, 3, Зеленый);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ДобавитьОформление(ИмяЭлемента, ПутьКУровню, Уровень, ЦветФона)

	Элемент = УсловноеОформление.Элементы.Добавить();
	Поле = Элемент.Поля.Элементы.Добавить();
	Поле.Поле = Новый ПолеКомпоновкиДанных(ИмяЭлемента);
	Отбор = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ПутьКУровню);
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Отбор.ПравоеЗначение = Уровень;
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветФона", ЦветФона);

КонецПроцедуры

#КонецОбласти

#Область Автопроверка

&НаКлиенте
Процедура ВыполнитьАвтопроверку()

	Результат = ОтправитьПравкиНаСервере();
	Закрыть(Новый Структура("Правки, Итог, Отчет", Результат.Правки, Результат.Итог, Результат.Отчет));

КонецПроцедуры

&НаСервере
Функция ОтчетАвтопроверки(ОтветПравок)

	Счетчики = Новый Соответствие;
	Для Каждого СтрокаПоля Из Поля Цикл
		Счетчики.Вставить(СтрокаПоля.Уровень, Количество(Счетчики, СтрокаПоля.Уровень) + 1);
	КонецЦикла;
	Ячеек = Новый Структура("Желтых, Красных", 0, 0);
	Для Каждого СтрокаТаблицы Из Строки Цикл
		Для Каждого Колонка Из КолонкиСтрок() Цикл
			Уровень = СтрокаТаблицы["Уровень" + Колонка.Колонка];
			Ячеек.Желтых = Ячеек.Желтых + ?(Уровень = 1, 1, 0);
			Ячеек.Красных = Ячеек.Красных + ?(Уровень = 2, 1, 0);
		КонецЦикла;
	КонецЦикла;

	БайтКартинки = 0;
	Если ЭтоАдресВременногоХранилища(АдресКартинки) Тогда
		БайтКартинки = ПолучитьИзВременногоХранилища(АдресКартинки).Размер();
	КонецЕсли;

	Возврат СтрШаблон("== Проверка ==
		|Реквизитов: %1; жёлтых: %2; красных: %3
		|Строк: %4; жёлтых ячеек: %5; красных ячеек: %6
		|Страниц: %7; картинка: %8 байт
		|Правки: %9",
		Поля.Количество(), Количество(Счетчики, 1), Количество(Счетчики, 2),
		Строки.Количество(), Ячеек.Желтых, Ячеек.Красных, ВсегоСтраниц, Формат(БайтКартинки, "ЧН=0; ЧГ=0"),
		?(ОтветПравок.Успех, СтрШаблон("отправлено %1, изменено %2", ОтветПравок.Всего, ОтветПравок.Изменено),
			"ошибка: " + ОтветПравок.Ошибка))
		+ Символы.ПС + Сводка + Символы.ПС + Символы.ПС + ОписаниеСопоставления();

КонецФункции

&НаСервереБезКонтекста
Функция Количество(Счетчики, Ключ)

	Значение = Счетчики.Получить(Ключ);
	Возврат ?(Значение = Неопределено, 0, Значение);

КонецФункции

