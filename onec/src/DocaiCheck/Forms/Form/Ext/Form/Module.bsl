// Проверка связи с сервисом docai (шаг P15).
//
// Способ А (основной): HTTP-запрос GET /v1/health к сервису на 127.0.0.1:8000.
// Способ Б (запасной): обмен файлами. Обработка кладёт запрос <ид>.json в папку
// <папка обмена>\inbox, сервис отвечает файлом <ид>.json в <папка обмена>\outbox.
//
// Запросы выполняются на сервере 1С. В файловой базе сервер — это тот же процесс
// на том же компьютере, поэтому 127.0.0.1 — адрес ноутбука, где запущен сервис.

&НаКлиенте
Перем ИдЗапросаФайлом;

&НаКлиенте
Перем ОсталосьОжидать;

&НаКлиенте
Перем ФайлАвтопроверки;

&НаКлиенте
Перем ОтветHTTPАвтопроверки;

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	Если ПустаяСтрока(Адрес) Тогда
		Адрес = "127.0.0.1";
	КонецЕсли;
	Если Порт = 0 Тогда
		Порт = 8000;
	КонецЕсли;
	Если ПустаяСтрока(ПапкаОбмена) Тогда
		ПапкаОбмена = "C:\DOCai-1c\data\service\exchange";
	КонецЕсли;

	// Автопроверка для scripts\onec_smoke.ps1: 1С запускается с параметром
	// /C "docai-smoke=<файл результата>". При обычном открытии ничего не делает.
	Префикс = "docai-smoke=";
	Если Лев(ПараметрЗапуска, СтрДлина(Префикс)) = Префикс Тогда
		ФайлАвтопроверки = Сред(ПараметрЗапуска, СтрДлина(Префикс) + 1);
		ПодключитьОбработчикОжидания("Автопроверка", 1, Истина);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СпособА_HTTP

&НаКлиенте
Процедура ПроверитьСвязь(Команда)

	Ответ = ЗапроситьСостояниеПоHTTP(Адрес, Порт);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗапроситьСостояниеПоHTTP(Знач Адрес, Знач Порт)

	// Таймаут 10 секунд: health отвечает быстро, долгое ожидание — признак проблемы.
	Попытка
		Соединение = Новый HTTPСоединение(Адрес, Порт, , , , 10);
		Запрос = Новый HTTPЗапрос("/v1/health");
		Запрос.Заголовки.Вставить("Accept", "application/json");
		ОтветHTTP = Соединение.Получить(Запрос);
	Исключение
		Возврат "Сервис не отвечает по адресу http://" + Адрес + ":" + Формат(Порт, "ЧГ=0") + "."
			+ Символы.ПС + "Запущен ли он? В PowerShell из папки проекта: .\scripts\start.ps1"
			+ Символы.ПС + Символы.ПС + "Ошибка 1С: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Тело = ОтветHTTP.ПолучитьТелоКакСтроку("UTF-8");
	Если ОтветHTTP.КодСостояния <> 200 Тогда
		Возврат "Сервис ответил кодом " + Формат(ОтветHTTP.КодСостояния, "ЧГ=0") + ":" + Символы.ПС + Тело;
	КонецЕсли;

	Возврат ОписаниеСостояния(Тело, "способ А, HTTP " + Формат(ОтветHTTP.КодСостояния, "ЧГ=0"));

КонецФункции

#КонецОбласти

#Область СпособБ_Файлы

&НаКлиенте
Процедура ПроверитьЧерезФайлы(Команда)

	ОтключитьОбработчикОжидания("ОжидатьОтветФайлом");
	Попытка
		ИдЗапросаФайлом = ОтправитьЗапросФайлом(ПапкаОбмена);
	Исключение
		ЗакончитьПроверкуФайлом("Не удалось положить запрос в папку " + ПапкаОбмена + "\inbox:"
			+ Символы.ПС + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	// Сервис просматривает папку раз в полсекунды; ждём ответ до 30 секунд.
	ОсталосьОжидать = 30;
	Ответ = "Запрос " + ИдЗапросаФайлом + ".json положен в inbox, жду ответ в outbox ...";
	ПодключитьОбработчикОжидания("ОжидатьОтветФайлом", 1, Ложь);

КонецПроцедуры

&НаКлиенте
Процедура ОжидатьОтветФайлом()

	Текст = ПрочитатьОтветФайлом(ПапкаОбмена, ИдЗапросаФайлом);
	Если Текст <> Неопределено Тогда
		ОтключитьОбработчикОжидания("ОжидатьОтветФайлом");
		ЗакончитьПроверкуФайлом(ОписаниеСостояния(Текст, "способ Б, файлы"));
		Возврат;
	КонецЕсли;

	ОсталосьОжидать = ОсталосьОжидать - 1;
	Если ОсталосьОжидать <= 0 Тогда
		ОтключитьОбработчикОжидания("ОжидатьОтветФайлом");
		ЗакончитьПроверкуФайлом("За 30 секунд ответа нет. Запущен ли сервис и та ли папка обмена?"
			+ Символы.ПС + "Сервис печатает свою папку обмена при запуске: «Обмен файлами с 1С: ...».");
	Иначе
		Ответ = "Запрос " + ИдЗапросаФайлом + ".json положен в inbox, жду ответ ... ("
			+ Формат(ОсталосьОжидать, "ЧГ=0") + " с)";
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗакончитьПроверкуФайлом(Текст)

	Ответ = Текст;
	Если ФайлАвтопроверки <> Неопределено Тогда
		ЗаписатьФайлАвтопроверки(ФайлАвтопроверки,
			"== Способ А ==" + Символы.ПС + ОтветHTTPАвтопроверки + Символы.ПС + Символы.ПС
			+ "== Способ Б ==" + Символы.ПС + Текст);
		ЗавершитьРаботуСистемы(Ложь);
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ОтправитьЗапросФайлом(Знач Папка)

	Ид = СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "");
	Входящие = Папка + "\inbox";
	СоздатьКаталог(Входящие);

	// Сначала пишем во временный файл и только потом переименовываем: сервис берёт
	// лишь файлы с расширением .json, поэтому не прочитает недописанный запрос.
	Временный = Входящие + "\" + Ид + ".tmp";
	Запись = Новый ЗаписьТекста(Временный, КодировкаТекста.UTF8);
	Запись.Записать("{""method"": ""health""}");
	Запись.Закрыть();
	ПереместитьФайл(Временный, Входящие + "\" + Ид + ".json");

	Возврат Ид;

КонецФункции

&НаСервереБезКонтекста
Функция ПрочитатьОтветФайлом(Знач Папка, Знач Ид)

	Путь = Папка + "\outbox\" + Ид + ".json";
	Файл = Новый Файл(Путь);
	Если Не Файл.Существует() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Чтение = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();
	УдалитьФайлы(Путь);
	Возврат Текст;

КонецФункции

#КонецОбласти

#Область Автопроверка

&НаКлиенте
Процедура Автопроверка()

	ПроверитьСвязь(Неопределено);
	ОтветHTTPАвтопроверки = Ответ;
	ПроверитьЧерезФайлы(Неопределено);

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаписатьФайлАвтопроверки(Знач Путь, Знач Текст)

	Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8);
	Запись.Записать(Текст);
	Запись.Закрыть();

КонецПроцедуры

#КонецОбласти

#Область Разбор

// Разбирает JSON ответа /v1/health и возвращает текст для поля «Ответ сервиса».
&НаСервереБезКонтекста
Функция ОписаниеСостояния(Знач ТекстJSON, Знач Способ)

	Попытка
		Данные = РазобратьJSON(ТекстJSON);
	Исключение
		Возврат "Сервис ответил (" + Способ + "), но разобрать JSON не удалось: "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + Символы.ПС + ТекстJSON;
	КонецПопытки;

	Если ТипЗнч(Данные) <> Тип("Структура") Или Не Данные.Свойство("status") Тогда
		Возврат "Сервис ответил (" + Способ + "):" + Символы.ПС + ТекстJSON;
	КонецЕсли;

	Строки = Новый Массив;
	Строки.Добавить("Связь есть (" + Способ + ").");
	Строки.Добавить("Состояние сервиса: " + Данные.status
		+ ?(Данные.status = "ok", " — готов к работе", " — работает не полностью"));
	Строки.Добавить("Версия: " + Данные.version);
	Строки.Добавить("Очередь: ждут " + Формат(Данные.queued, "ЧН=0; ЧГ=0")
		+ ", выполняется " + Формат(Данные.running, "ЧН=0; ЧГ=0")
		+ "; воркер " + ?(Данные.worker_alive = Истина, "работает", "НЕ работает"));

	Ollama = Данные.ollama;
	Если ТипЗнч(Ollama) = Тип("Структура") Тогда
		Строки.Добавить("Ollama: " + ?(Ollama.reachable = Истина, "доступна", "недоступна")
			+ "; модель " + Ollama.model
			+ ?(Ollama.model_available = Истина, " скачана", " НЕ скачана")
			+ ?(Ollama.model_loaded = Истина, ", загружена в память", ""));
		Если Ollama.error <> Неопределено Тогда
			Строки.Добавить("  причина: " + Ollama.error);
		КонецЕсли;
	КонецЕсли;

	GPU = Данные.gpu;
	Если ТипЗнч(GPU) = Тип("Структура") Тогда
		Если GPU.available = Истина Тогда
			Строки.Добавить("Видеопамять: свободно " + Формат(GPU.vram_free_mib, "ЧГ=0")
				+ " из " + Формат(GPU.vram_total_mib, "ЧГ=0") + " МиБ");
		Иначе
			Строки.Добавить("GPU: нет данных (" + GPU.error + ")");
		КонецЕсли;
	КонецЕсли;

	Строки.Добавить("");
	Строки.Добавить("Ответ целиком:");
	Строки.Добавить(ТекстJSON);

	// Не СтрСоединить: её нет в режиме совместимости 8.3.5 и ниже.
	Результат = "";
	Для Каждого Часть Из Строки Цикл
		Результат = Результат + ?(Результат = "", "", Символы.ПС) + Часть;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Разбор JSON в Структуру (объекты) и Массив без глобальной ПрочитатьJSON: её, как
// и СтрСоединить, нет, если конфигурация работает в режиме совместимости 8.3.5 и ниже
// (проверено на 8.2.16). Ключи ответа сервиса — латиница, годятся как ключи Структуры.
&НаСервереБезКонтекста
Функция РазобратьJSON(Знач Текст)

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Текст);
	Чтение.Прочитать();
	Значение = ПрочитатьЗначениеJSON(Чтение);
	Чтение.Закрыть();
	Возврат Значение;

КонецФункции

&НаСервереБезКонтекста
Функция ПрочитатьЗначениеJSON(Чтение)

	Вид = Чтение.ТипТекущегоЗначения;
	Если Вид = ТипЗначенияJSON.НачалоОбъекта Тогда
		Объект = Новый Структура;
		Пока Чтение.Прочитать() И Чтение.ТипТекущегоЗначения = ТипЗначенияJSON.ИмяСвойства Цикл
			Имя = Чтение.ТекущееЗначение;
			Чтение.Прочитать();
			Объект.Вставить(Имя, ПрочитатьЗначениеJSON(Чтение));
		КонецЦикла;
		Возврат Объект;
	ИначеЕсли Вид = ТипЗначенияJSON.НачалоМассива Тогда
		Массив = Новый Массив;
		Пока Чтение.Прочитать() И Чтение.ТипТекущегоЗначения <> ТипЗначенияJSON.КонецМассива Цикл
			Массив.Добавить(ПрочитатьЗначениеJSON(Чтение));
		КонецЦикла;
		Возврат Массив;
	ИначеЕсли Вид = ТипЗначенияJSON.Null Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Чтение.ТекущееЗначение;

КонецФункции

#КонецОбласти