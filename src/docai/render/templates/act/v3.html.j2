{% extends "act/base.html.j2" %}
{% block head %}
{% import "_macros.html.j2" as m %}
<div class="headrow">{{ m.logo(deco, 13) }}<div class="title t">Акт выполненных работ № {{ m.f('number', d.number) }} от {{ m.f('date', d.date|dnum) }}</div></div>
<div class="cards" style="grid-template-columns:1fr 1fr;margin-top:3mm">
 <div class="card"><div class="l">Исполнитель</div>{{ m.f('seller.name', d.seller.name) }}<br>ИНН {{ m.f('seller.inn', d.seller.inn) }}{% if d.seller.kpp %}, КПП {{ m.f('seller.kpp', d.seller.kpp) }}{% endif %}<br>{{ m.f('seller.address', d.seller.address) }}{% if d.seller_bank %}<br>{{ m.bank_inline(d.seller_bank) }}{% endif %}</div>
 <div class="card"><div class="l">Заказчик</div>{{ m.f('buyer.name', d.buyer.name) }}<br>ИНН {{ m.f('buyer.inn', d.buyer.inn) }}{% if d.buyer.kpp %}, КПП {{ m.f('buyer.kpp', d.buyer.kpp) }}{% endif %}<br>{{ m.f('buyer.address', d.buyer.address) }}</div>
</div>
{% if d.basis %}<div style="margin-bottom:3mm"><span class="small">Основание:</span> {{ m.basis(d.basis) }}</div>{% endif %}
{% endblock %}
{% block foot %}
{% import "_macros.html.j2" as m %}
{{ m.summary(d) }}
<div class="sg sg2" style="margin-top:6mm">
 <div class="sigbox sigline">Исполнитель{{ m.sign(deco, 24, '5mm', '-9mm') }}</div>
 <div class="sigline">Заказчик</div>
</div>
<div class="sigbox" style="height:30mm">{{ m.stamp(deco, 30, '10mm', '2mm') }}</div>
{% endblock %}
