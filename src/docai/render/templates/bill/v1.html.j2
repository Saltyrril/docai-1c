{% extends "bill/base.html.j2" %}
{% block head %}
{% import "_macros.html.j2" as m %}
<div style="display:flex;gap:4mm;align-items:center;margin-bottom:2mm">{{ m.logo(deco, 14) }}<div class="small" style="flex:1">Внимание! Оплата данного счёта означает согласие с условиями поставки товара. Уведомление об оплате обязательно, в противном случае не гарантируется наличие товара на складе.</div></div>
{{ m.bank_table(d) }}
<div class="title" style="text-align:left;font-size:14pt;border-bottom:2px solid #000;padding-bottom:1mm">Счёт на оплату № {{ m.f('number', d.number) }} от {{ m.f('date', d.date|dnum) }}</div>
<div class="req2">
 <div class="k">Поставщик:</div><div>{{ m.f('seller.name', d.seller.name) }}, ИНН {{ m.f('seller.inn', d.seller.inn) }}{% if d.seller.kpp %}, КПП {{ m.f('seller.kpp', d.seller.kpp) }}{% endif %}{% if d.seller.address %}, {{ m.f('seller.address', d.seller.address) }}{% endif %}</div>
 <div class="k">Покупатель:</div><div>{{ m.f('buyer.name', d.buyer.name) }}, ИНН {{ m.f('buyer.inn', d.buyer.inn) }}{% if d.buyer.kpp %}, КПП {{ m.f('buyer.kpp', d.buyer.kpp) }}{% endif %}{% if d.buyer.address %}, {{ m.f('buyer.address', d.buyer.address) }}{% endif %}</div>
 {% if d.basis %}<div class="k">Основание:</div><div>{{ m.basis(d.basis) }}</div>{% endif %}
</div>
{% endblock %}
{% block foot %}
{% import "_macros.html.j2" as m %}
{{ m.summary(d) }}
<div class="sigbox" style="margin-top:6mm">
 <div style="display:flex;gap:10mm"><div style="flex:1"><div style="height:8mm">Руководитель</div><div class="sigline" style="margin-top:0">{{ m.sign(deco, 24, '8mm', '-9mm') }}(подпись) &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; (расшифровка)</div></div>
 <div style="flex:1"><div style="height:8mm">Бухгалтер</div><div class="sigline" style="margin-top:0">(подпись) &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; (расшифровка)</div></div></div>
 <div style="height:26mm;position:relative">{{ m.stamp(deco, 28, '60mm', '-4mm') }}</div>
</div>
{% endblock %}
